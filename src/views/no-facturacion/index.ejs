<%- include('../partials/header') %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Facturación</h1>
        <div>
            <button type="button" class="btn btn-primary me-2" id="generarFacturas">
                <i class="fas fa-file-invoice-dollar"></i> Generar Facturas
            </button>
            <button type="button" class="btn btn-success" id="exportarExcel">
                <i class="fas fa-file-excel"></i> Exportar a Excel
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <!-- Filtros -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="filtroMes" class="form-label">Mes</label>
                    <select id="filtroMes" class="form-select">
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filtroAnio" class="form-label">Año</label>
                    <select id="filtroAnio" class="form-select">
                        <!-- Se llenará dinámicamente -->
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filtroEstado" class="form-label">Estado</label>
                    <select id="filtroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="pendiente">Pendiente</option>
                        <option value="pagada">Pagada</option>
                        <option value="vencida">Vencida</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table id="facturasTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nº Factura</th>
                            <th>Cliente</th>
                            <th>Plan</th>
                            <th>Fecha Emisión</th>
                            <th>Fecha Vencimiento</th>
                            <th>Monto</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Los datos se cargarán dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Pago -->
<div class="modal fade" id="pagoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="pagoForm">
                    <input type="hidden" id="facturaId">
                    <div class="mb-3">
                        <label for="fechaPago" class="form-label">Fecha de Pago</label>
                        <input type="date" class="form-control" id="fechaPago" required>
                    </div>
                    <div class="mb-3">
                        <label for="metodoPago" class="form-label">Método de Pago</label>
                        <select class="form-select" id="metodoPago" required>
                            <option value="">Seleccione un método</option>
                            <option value="efectivo">Efectivo</option>
                            <option value="transferencia">Transferencia</option>
                            <option value="deposito">Depósito</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="referenciaPago" class="form-label">Referencia de Pago</label>
                        <input type="text" class="form-control" id="referenciaPago">
                        <div class="form-text">Opcional. Número de transferencia o depósito.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarPago">
                    <i class="fas fa-save"></i> Registrar Pago
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Obtener el token CSRF del meta tag
const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

$(document).ready(function() {
    // Llenar el select de años
    const selectAnio = $('#filtroAnio');
    const anioActual = new Date().getFullYear();
    for (let i = anioActual; i >= anioActual - 2; i--) {
        selectAnio.append(`<option value="${i}">${i}</option>`);
    }

    // Establecer mes y año actual
    const mesActual = new Date().getMonth() + 1;
    $('#filtroMes').val(mesActual);
    $('#filtroAnio').val(anioActual);

    // Inicializar DataTable
    const table = $('#facturasTable').DataTable({
        ajax: {
            url: '/facturacion/list',
            data: function(d) {
                d.mes = $('#filtroMes').val();
                d.anio = $('#filtroAnio').val();
                d.estado = $('#filtroEstado').val();
            },
            dataSrc: ''
        },
        columns: [
            { data: 'numero_factura' },
            { 
                data: null,
                render: function(data) {
                    return `${data.cliente_nombre} ${data.cliente_apellido}`;
                }
            },
            { 
                data: null,
                render: function(data) {
                    return `${data.plan_nombre}<br>
                           <small class="text-muted">
                               ↓${data.velocidad_descarga}Mbps ↑${data.velocidad_subida}Mbps
                           </small>`;
                }
            },
            { 
                data: 'fecha_emision',
                render: function(data) {
                    return new Date(data).toLocaleDateString('es-HN');
                }
            },
            { 
                data: 'fecha_vencimiento',
                render: function(data) {
                    return new Date(data).toLocaleDateString('es-HN');
                }
            },
            { 
                data: 'monto',
                render: function(data) {
                    return 'L ' + parseFloat(data).toFixed(2);
                }
            },
            {
                data: 'estado',
                render: function(data) {
                    const badges = {
                        'pendiente': 'warning',
                        'pagada': 'success',
                        'vencida': 'danger'
                    };
                    const estados = {
                        'pendiente': 'Pendiente',
                        'pagada': 'Pagada',
                        'vencida': 'Vencida'
                    };
                    return `<span class="badge bg-${badges[data]}">${estados[data]}</span>`;
                }
            },
            {
                data: null,
                orderable: false,
                render: function(data) {
                    const btnPagar = data.estado === 'pendiente' || data.estado === 'vencida' ?
                        `<button class="btn btn-sm btn-success registrar-pago me-1" 
                                data-factura-id="${data.id}" title="Registrar Pago">
                            <i class="fas fa-money-bill-wave"></i>
                        </button>` : '';

                    return `
                        ${btnPagar}
                        <a href="/facturacion/${data.id}/pdf" class="btn btn-sm btn-primary" 
                           target="_blank" title="Ver PDF">
                            <i class="fas fa-file-pdf"></i>
                        </a>
                    `;
                }
            }
        ],
        order: [[3, 'desc']],
        language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
        },
        responsive: true
    });

    // Resto del código JavaScript...
});
</script>

<%- include('../partials/footer') %> 