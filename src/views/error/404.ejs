<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Dimensión no encontrada</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;700&family=Exo+2:wght@400;500;600&display=swap');
        
        :root {
            --primary: #00f0ff;
            --secondary: #7b61ff;
            --dark: #0a0e17;
            --light: #e0f2fe;
        }
        
        body {
            background-color: var(--dark);
            font-family: 'Exo 2', sans-serif;
            color: var(--light);
            overflow-x: hidden;
        }
        
        .futurist-bg {
            background: 
                radial-gradient(circle at 20% 30%, rgba(0, 240, 255, 0.05) 0%, transparent 25%),
                radial-gradient(circle at 80% 70%, rgba(123, 97, 255, 0.05) 0%, transparent 25%),
                linear-gradient(to bottom, #0a0e17, #0f172a);
        }
        
        .grid-pattern {
            background-image: 
                linear-gradient(rgba(0, 240, 255, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.1) 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.3;
        }
        
        .title-font {
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            letter-spacing: 0.05em;
        }
        
        .error-container {
            background: rgba(10, 14, 23, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 240, 255, 0.2);
            box-shadow: 
                0 0 20px rgba(0, 240, 255, 0.1),
                inset 0 0 20px rgba(0, 240, 255, 0.05);
            border-radius: 16px;
        }
        
        .holographic-circle {
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: conic-gradient(
                from 180deg at 50% 50%,
                rgba(0, 240, 255, 0) 0deg,
                rgba(0, 240, 255, 0.3) 90deg,
                rgba(123, 97, 255, 0.5) 180deg,
                rgba(123, 97, 255, 0.3) 270deg,
                rgba(0, 240, 255, 0) 360deg
            );
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: rotate 20s linear infinite;
        }
        
        .holographic-circle::before {
            content: '';
            position: absolute;
            width: 92%;
            height: 92%;
            border-radius: 50%;
            background: var(--dark);
        }
        
        .error-code {
            position: relative;
            z-index: 2;
            font-size: 3.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .futurist-btn {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0, 240, 255, 0.3);
            transition: all 0.3s ease;
            background: rgba(10, 14, 23, 0.7);
            font-weight: 500;
        }
        
        .futurist-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 240, 255, 0.2);
            border-color: rgba(0, 240, 255, 0.6);
        }
        
        .futurist-btn-primary {
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(123, 97, 255, 0.2));
        }
        
        .futurist-btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(0, 240, 255, 0.2),
                transparent
            );
            transition: 0.5s;
        }
        
        .futurist-btn-primary:hover::before {
            left: 100%;
        }
        
        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        
        .scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                linear-gradient(
                    to bottom,
                    transparent 95%,
                    rgba(0, 240, 255, 0.03) 96%,
                    transparent 97%
                );
            background-size: 100% 8px;
            pointer-events: none;
            z-index: 5;
            animation: scanline 8s linear infinite;
        }
        
        @keyframes scanline {
            from { background-position: 0 0; }
            to { background-position: 0 100%; }
        }
    </style>
</head>
<body class="futurist-bg min-h-screen flex items-center justify-center p-4">
    <div class="grid-pattern fixed inset-0 z-0"></div>
    <div class="scanlines"></div>
    
    <div class="error-container relative z-10 p-8 sm:p-12 max-w-2xl w-full">
        <div class="flex flex-col items-center text-center">
            <!-- Holographic Circle -->
            <div class="holographic-circle mb-10">
                <div class="error-code">404</div>
            </div>
            
            <!-- Title -->
            <h1 class="title-font text-3xl sm:text-4xl mb-4 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-400">
                DIMENSIÓN NO ENCONTRADA
            </h1>
            
            <!-- Description -->
            <p class="text-lg sm:text-xl mb-10 leading-relaxed max-w-2xl">
                El recurso solicitado no existe en nuestra matriz digital.
                <br>Puede haber sido movido, eliminado o nunca haber existido en esta línea temporal.
            </p>
            
            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                <a href="javascript:history.back()" 
                   class="futurist-btn futurist-btn-primary py-3 px-6 rounded-lg flex items-center justify-center gap-2">
                    <i class="fas fa-arrow-left"></i>
                    <span>Retroceder</span>
                </a>
                
                <a href="/dashboard" 
                   class="futurist-btn py-3 px-6 rounded-lg flex items-center justify-center gap-2 hover:bg-slate-800/50">
                    <i class="fas fa-home"></i>
                    <span>Portal Principal</span>
                </a>
            </div>
            
            <!-- Tech Info -->
            <div class="mt-12 text-sm text-slate-400">
                <p>Código de error: <span class="text-cyan-300">HTTP 404</span></p>
                <p class="mt-1">Servidor: <span class="text-indigo-300">Nexus-7</span> | Protocolo: <span class="text-cyan-300">HyperText v2.4</span></p>
            </div>
        </div>
    </div>

    <script>
        // Efecto de movimiento holográfico
        document.addEventListener('DOMContentLoaded', () => {
            const circle = document.querySelector('.holographic-circle');
            if(circle) {
                circle.addEventListener('mouseenter', () => {
                    circle.style.animation = 'rotate 5s linear infinite';
                });
                
                circle.addEventListener('mouseleave', () => {
                    circle.style.animation = 'rotate 20s linear infinite';
                });
            }
            
            // Efecto de flotación para el contenedor
            const container = document.querySelector('.error-container');
            if(container) {
                container.style.animation = 'float 6s ease-in-out infinite';
            }
        });
    </script>
</body>
</html>