<%- include('../partials/header') %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Contabilidad</h1>
        <a href="/pagos" class="btn btn-danger">
            <i class="fas fa-minus-circle"></i> Registrar Gasto
        </a>
    </div>

    <!-- Filtros y Resumen -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label for="filtroMes" class="form-label">Mes</label>
            <select id="filtroMes" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label for="filtroAnio" class="form-label">Año</label>
            <select id="filtroAnio" class="form-select"></select>
        </div>
        <!-- Tarjetas de Resumen -->
        <div class="col-md-2">
            <div class="card border-left-success shadow h-100">
                <div class="card-body text-center">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Ingresos</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalIngresos">$0.00</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-danger shadow h-100">
                <div class="card-body text-center">
                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Egresos</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalEgresos">$0.00</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-left-info shadow h-100">
                <div class="card-body text-center">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Saldo</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800" id="saldoMes">$0.00</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table id="movimientosTable" class="table table-striped table-hover" width="100%">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Cliente</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Los datos se cargarán dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- DataTables CSS y JS -->
<link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

<script>
$(document).ready(function() {
    const meses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
    const anioActual = new Date().getFullYear();
    const mesActual = new Date().getMonth() + 1;

    // Poblar select de meses
    meses.forEach((mes, index) => {
        $('#filtroMes').append(new Option(mes, index + 1));
    });

    // Poblar select de años
    for (let i = anioActual; i >= anioActual - 5; i--) {
        $('#filtroAnio').append(new Option(i, i));
    }

    // Seleccionar mes y año actual por defecto
    $('#filtroMes').val(mesActual);
    $('#filtroAnio').val(anioActual);

    const table = $('#movimientosTable').DataTable({
        ajax: {
            url: '/contabilidad/list',
            dataSrc: ''
        },
        columns: [
            {
                data: 'fecha',
                render: function(data) {
                    if (!data) return '';
                    const fecha = new Date(data);
                    return fecha.toLocaleString('es-HN', {
                        year: 'numeric', month: '2-digit', day: '2-digit',
                        hour: '2-digit', minute: '2-digit', hour12: true
                    });
                }
            },
            {
                data: 'tipo',
                render: function(data) {
                    const color = data === 'ingreso' ? 'success' : 'danger';
                    return `<span class="badge bg-${color}">${data.toUpperCase()}</span>`;
                }
            },
            { data: 'descripcion' },
            { data: 'cliente_nombre', defaultContent: '<span class="text-muted">N/A</span>' },
            {
                data: 'monto',
                className: 'text-end',
                render: function(data, type, row) {
                    const sign = row.tipo === 'ingreso' ? '+' : '-';
                    const color = row.tipo === 'ingreso' ? 'text-success' : 'text-danger';
                    const formattedAmount = parseFloat(data).toLocaleString('es-HN', { style: 'currency', currency: 'HNL' });
                    return `<strong class="${color}">${sign} ${formattedAmount}</strong>`;
                }
            }
        ],
        language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
        },
        order: [[0, 'desc']],
        responsive: true
    });

    function formatoMoneda(valor) {
        return parseFloat(valor).toLocaleString('es-HN', { style: 'currency', currency: 'HNL' });
    }

    async function cargarDatosContables() {
        const mes = $('#filtroMes').val();
        const anio = $('#filtroAnio').val();

        // 1. Cargar resumen
        const summaryResponse = await fetch(`/contabilidad/summary?mes=${mes}&anio=${anio}`);
        const summary = await summaryResponse.json();
        
        $('#totalIngresos').text(formatoMoneda(summary.totalIngresos));
        $('#totalEgresos').text(formatoMoneda(summary.totalEgresos));
        const saldo = summary.totalIngresos - summary.totalEgresos;
        $('#saldoMes').text(formatoMoneda(saldo));
        $('#saldoMes').css('color', saldo >= 0 ? 'green' : 'red');

        // 2. Recargar la tabla con los nuevos filtros
        table.ajax.url(`/contabilidad/list?mes=${mes}&anio=${anio}`).load();
    }

    // Evento para cuando cambian los filtros
    $('#filtroMes, #filtroAnio').on('change', cargarDatosContables);

    // Carga inicial de datos
    cargarDatosContables();
});
</script>