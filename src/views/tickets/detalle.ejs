<%- include('../partials/header') %>
<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<div class="container-fluid px-4">
    <!-- Detalles del Ticket -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Detalles del Ticket <%= ticket.ticket_codigo || ('#' + ticket.id) %></h1>
        <a href="/tickets" class="btn btn-secondary">Volver a la lista</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary"><%= ticket.asunto %></h6>
        </div>
        <div class="card-body">
            <p><strong>Cliente:</strong> <%= ticket.cliente_nombre %> <%= ticket.cliente_apellido %></p>
            <p>
                <strong>Estado:</strong>
                <% if (ticket.estado === 'pendiente') { %>
                    <span class="badge bg-warning text-dark">Pendiente</span>
                <% } else if (ticket.estado === 'abierto') { %>
                    <span class="badge bg-success">Abierto</span>
                <% } else if (ticket.estado === 'en_proceso') { %>
                    <span class="badge bg-warning">En Proceso</span>
                <% } else if (ticket.estado === 'resuelto') { %>
                    <span class="badge bg-info">Resuelto</span>
                <% } else if (ticket.estado === 'cerrado') { %>
                    <span class="badge bg-secondary">Cerrado</span>
                <% } else { %>
                    <span class="badge bg-dark"><%= ticket.estado %></span>
                <% } %>
            </p>
            <p><strong>Prioridad:</strong> <span class="badge bg-info"><%= ticket.prioridad %></span></p>
            <p><strong>Descripción:</strong></p>
            <p><%- ticket.descripcion.replace(/\n/g, '<br>') %></p>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header">Gestion del Ticket</div>
        <div class="card-body">
            <form id="ticketEstadoForm" class="row g-3 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4">
                    <label for="estadoTicket" class="form-label">Estado</label>
                    <select id="estadoTicket" name="estado" class="form-select" required>
                        <option value="pendiente" <%= ticket.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                        <option value="abierto" <%= ticket.estado === 'abierto' ? 'selected' : '' %>>Abierto</option>
                        <option value="en_proceso" <%= ticket.estado === 'en_proceso' ? 'selected' : '' %>>En proceso</option>
                        <option value="resuelto" <%= ticket.estado === 'resuelto' ? 'selected' : '' %>>Resuelto</option>
                        <option value="cerrado" <%= ticket.estado === 'cerrado' ? 'selected' : '' %>>Cerrado</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="prioridadTicket" class="form-label">Prioridad</label>
                    <select id="prioridadTicket" name="prioridad" class="form-select" required>
                        <option value="baja" <%= ticket.prioridad === 'baja' ? 'selected' : '' %>>Baja</option>
                        <option value="media" <%= ticket.prioridad === 'media' ? 'selected' : '' %>>Media</option>
                        <option value="alta" <%= ticket.prioridad === 'alta' ? 'selected' : '' %>>Alta</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <!-- SECCIÓN DE SERVICIOS Y COSTOS (NUEVO) -->
    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Servicios y Costos Asociados</h6>
            <h5 class="m-0 font-weight-bold">Total Ticket: <span class="text-danger"><%= new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(totalTicket || 0) %></span></h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="border rounded p-2 text-center">
                        <small class="text-muted d-block">Total servicios</small>
                        <strong id="totalServiciosValue"><%= new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(totalServicios || 0) %></strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-2 text-center">
                        <small class="text-muted d-block">Total costos operativos</small>
                        <strong id="totalCostosValue"><%= new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(totalCostos || 0) %></strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-2 text-center bg-light">
                        <small class="text-muted d-block">Total general ticket</small>
                        <strong id="totalTicketValue" class="text-danger"><%= new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(totalTicket || 0) %></strong>
                    </div>
                </div>
            </div>

            <!-- Formulario para añadir nuevo servicio -->
            <form id="addServiceForm" class="row g-3 align-items-center mb-4 border-bottom pb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-6">
                    <label for="servicio_id" class="form-label">Servicio</label>
                    <select id="servicio_id" name="servicio_id" class="form-select"></select>
                    <small class="text-muted">Si no aparece, ingrésalo abajo como servicio nuevo.</small>
                </div>
                <div class="col-md-3">
                    <label for="cantidad" class="form-label">Cantidad</label>
                    <input type="number" id="cantidad" name="cantidad" class="form-control" value="1" min="1" required>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Añadir Servicio</button>
                </div>
                <div class="col-md-8">
                    <label for="nuevo_servicio_nombre" class="form-label">Nuevo servicio/producto (opcional)</label>
                    <input type="text" id="nuevo_servicio_nombre" name="nuevo_servicio_nombre" class="form-control" placeholder="Ej: Terminal ONU, Conector RJ45, Visita técnica">
                </div>
                <div class="col-md-4">
                    <label for="nuevo_servicio_precio" class="form-label">Precio nuevo servicio (HNL)</label>
                    <input type="number" step="0.01" min="0.01" id="nuevo_servicio_precio" name="nuevo_servicio_precio" class="form-control" placeholder="Ej: 150.00">
                </div>
            </form>

            <!-- Tabla de servicios ya añadidos -->
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio Unitario</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody id="servicesTableBody">
                    <% servicios.forEach(s => { %>
                        <tr data-service-row-id="<%= s.id %>" data-cantidad="<%= s.cantidad %>">
                            <td><%= s.nombre %></td>
                            <td class="text-center"><%= s.cantidad %></td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">L</span>
                                    <input
                                        type="number"
                                        step="0.01"
                                        min="0.01"
                                        class="form-control service-price-input"
                                        value="<%= Number(s.precio_unitario).toFixed(2) %>"
                                        data-id="<%= s.id %>"
                                    >
                                    <button class="btn btn-outline-primary save-price-btn" type="button" data-id="<%= s.id %>" title="Guardar precio">
                                        <i class="fas fa-save"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="text-end service-subtotal" data-id="<%= s.id %>"><%= new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(s.cantidad * s.precio_unitario) %></td>
                            <td class="text-center">
                                <button class="btn btn-xs btn-outline-danger remove-service-btn" data-id="<%= s.id %>" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (servicios.length === 0) { %>
                        <tr><td colspan="5" class="text-center text-muted">No hay servicios asociados a este ticket.</td></tr>
                    <% } %>
                </tbody>
            </table>

            <hr class="my-4">

            <h6 class="font-weight-bold text-primary">Costos Operativos del Ticket</h6>
            <p class="text-muted small mb-3">Registra gastos como combustible, terminales, cableado, conectores u otros costos de campo.</p>

            <form id="addCostForm" class="row g-3 align-items-end mb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-8">
                    <label for="costoDescripcion" class="form-label">Descripcion del costo</label>
                    <input type="text" id="costoDescripcion" name="descripcion" class="form-control" placeholder="Ej: Combustible visita a casa del cliente" required>
                </div>
                <div class="col-md-2">
                    <label for="costoMonto" class="form-label">Monto (HNL)</label>
                    <input type="number" step="0.01" min="0.01" id="costoMonto" name="monto" class="form-control" required>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-success w-100">Agregar costo</button>
                </div>
            </form>

            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Descripcion</th>
                        <th class="text-end">Monto</th>
                        <th class="text-center">Accion</th>
                    </tr>
                </thead>
                <tbody id="costsTableBody">
                    <% costos.forEach(c => { %>
                        <tr>
                            <td><%= c.descripcion %></td>
                            <td class="text-end"><%= new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(c.monto) %></td>
                            <td class="text-center">
                                <button class="btn btn-xs btn-outline-danger remove-cost-btn" data-id="<%= c.id %>" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (costos.length === 0) { %>
                        <tr><td colspan="3" class="text-center text-muted">No hay costos operativos registrados.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Formulario para Nuevo Comentario -->
    <div class="card shadow mb-4">
        <div class="card-header">Añadir Actualización</div>
        <div class="card-body">
            <form id="commentForm" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label for="comentario" class="form-label">Comentario</label>
                    <textarea class="form-control" id="comentario" name="comentario" rows="3" required></textarea>
                </div>
                <div class="mb-3">
                    <label for="foto" class="form-label">Adjuntar Foto (Opcional)</label>
                    <input class="form-control" type="file" id="foto" name="foto" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary">Añadir Comentario</button>
            </form>
        </div>
    </div>

    <!-- Historial de Comentarios -->
    <div class="card shadow mb-4">
        <div class="card-header">Historial de Actualizaciones</div>
        <div class="list-group list-group-flush" id="commentList">
            <% comentarios.forEach(comentario => { %>
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1"><strong><%= comentario.autor_nombre %></strong></h6>
                        <small class="text-muted js-local-datetime" data-utc="<%= new Date(comentario.created_at).toISOString() %>">
                            <%= new Date(comentario.created_at).toISOString() %>
                        </small>
                    </div>
                    <p class="mb-1"><%- comentario.comentario.replace(/\n/g, '<br>') %></p>
                    <% if (comentario.foto_url) { %>
                        <a href="<%= comentario.foto_url %>" target="_blank">
                            <img src="<%= comentario.foto_url %>" alt="Foto adjunta" class="img-thumbnail mt-2" style="max-width: 200px;">
                        </a>
                    <% } %>
                </div>
            <% }) %>
            <% if (comentarios.length === 0) { %>
                <div class="list-group-item">No hay comentarios todavía.</div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
$(document).ready(function() {
    const csrfToken = '<%= csrfToken %>';
    const monedaHNL = new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' });

    // Mostrar fechas en zona horaria del navegador del usuario
    $('.js-local-datetime').each(function() {
        const utc = $(this).data('utc');
        if (!utc) return;
        const localDate = new Date(utc);
        $(this).text(localDate.toLocaleString());
    });

    $('#ticketEstadoForm').on('submit', async function(e) {
        e.preventDefault();
        const payload = {
            estado: $('#estadoTicket').val(),
            prioridad: $('#prioridadTicket').val()
        };

        try {
            const response = await fetch('/tickets/<%= ticket.id %>/estado', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': csrfToken
                },
                body: JSON.stringify(payload)
            });
            const result = await response.json();
            if (!response.ok || !result.success) {
                throw new Error(result.error || 'No se pudo actualizar el ticket.');
            }
            Swal.fire('Actualizado', result.message, 'success').then(() => location.reload());
        } catch (error) {
            Swal.fire('Error', error.message, 'error');
        }
    });

    // --- LÓGICA PARA COMENTARIOS (EXISTENTE) ---
    $('#commentForm').on('submit', async function(e) {
        e.preventDefault();
        const form = this;
        const formData = new FormData(form);

        try {
            const response = await fetch('/tickets/<%= ticket.id %>/comentarios', {
                method: 'POST',
                body: formData,
                headers: {
                    'CSRF-Token': csrfToken
                }
            });
            const contentType = response.headers.get('content-type') || '';
            let result;
            if (contentType.includes('application/json')) {
                result = await response.json();
            } else {
                const text = await response.text();
                throw new Error(`Respuesta inesperada del servidor (${response.status}). ${text.slice(0, 120)}`);
            }

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });
            } else {
                throw new Error(result.error);
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'No se pudo añadir el comentario.'
            });
        }
    });

    // --- LÓGICA PARA SERVICIOS Y COSTOS (NUEVO) ---
    // 1. Cargar catálogo de servicios en el select
    async function loadServicesCatalog() {
        try {
            const response = await fetch('/tickets/servicios-catalogo');
            const services = await response.json();
            const select = $('#servicio_id');
            select.empty();
            select.append(new Option('', '')); // Para el placeholder
            services.forEach(s => {
                select.append(new Option(`${s.nombre} - ${new Intl.NumberFormat('es-HN', { style: 'currency', currency: 'HNL' }).format(s.precio)}`, s.id));
            });
            select.select2({
                theme: 'bootstrap-5',
                placeholder: 'Seleccione un servicio o producto...'
            });
        } catch (error) {
            console.error('Error al cargar catálogo de servicios:', error);
        }
    }
    loadServicesCatalog();

    // 2. Manejar el envío del formulario para añadir servicio
    $('#addServiceForm').on('submit', async function(e) {
        e.preventDefault();
        const form = this;
        const servicioId = $('#servicio_id').val();
        const nuevoNombre = ($('#nuevo_servicio_nombre').val() || '').trim();
        const nuevoPrecio = ($('#nuevo_servicio_precio').val() || '').trim();

        if (!servicioId && !nuevoNombre) {
            Swal.fire('Atención', 'Seleccione un servicio existente o ingrese uno nuevo.', 'warning');
            return;
        }
        if (nuevoNombre && !nuevoPrecio) {
            Swal.fire('Atención', 'Ingrese el precio del nuevo servicio.', 'warning');
            return;
        }

        const formData = new URLSearchParams(new FormData(form));
        
        try {
            const response = await fetch('/tickets/<%= ticket.id %>/servicios', {
                method: 'POST',
                body: formData,
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'CSRF-Token': csrfToken
                }
            });
            const result = await response.json();
            if (result.success) {
                const s = result.servicio;
                const tbody = $('#servicesTableBody');
                const emptyRow = tbody.find('tr td[colspan="5"]');
                if (emptyRow.length) {
                    emptyRow.closest('tr').remove();
                }

                const rowHtml = `
                    <tr data-service-row-id="${s.id}" data-cantidad="${s.cantidad}">
                        <td>${s.nombre}</td>
                        <td class="text-center">${s.cantidad}</td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">L</span>
                                <input
                                    type="number"
                                    step="0.01"
                                    min="0.01"
                                    class="form-control service-price-input"
                                    value="${Number(s.precio_unitario).toFixed(2)}"
                                    data-id="${s.id}"
                                >
                                <button class="btn btn-outline-primary save-price-btn" type="button" data-id="${s.id}" title="Guardar precio">
                                    <i class="fas fa-save"></i>
                                </button>
                            </div>
                        </td>
                        <td class="text-end service-subtotal" data-id="${s.id}">${monedaHNL.format(s.subtotal)}</td>
                        <td class="text-center">
                            <button class="btn btn-xs btn-outline-danger remove-service-btn" data-id="${s.id}" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.prepend(rowHtml);

                if (result.totales) {
                    $('#totalServiciosValue').text(monedaHNL.format(result.totales.total_servicios || 0));
                    $('#totalCostosValue').text(monedaHNL.format(result.totales.total_costos || 0));
                    $('#totalTicketValue').text(monedaHNL.format(result.totales.total_ticket || 0));
                }

                form.reset();
                $('#cantidad').val(1);
                $('#servicio_id').val('').trigger('change');
                $('#nuevo_servicio_nombre').val('');
                $('#nuevo_servicio_precio').val('');

                Swal.fire({
                    icon: 'success',
                    title: 'Servicio agregado',
                    timer: 1200,
                    showConfirmButton: false
                });
            } else { throw new Error(result.error); }
        } catch (error) {
            Swal.fire('Error', error.message || 'No se pudo añadir el servicio.', 'error');
        }
    });

    // 3. Manejar el clic en el botón de eliminar servicio
    $('#servicesTableBody').on('click', '.remove-service-btn', function() {
        const ticketServicioId = $(this).data('id');
        
        Swal.fire({
            title: '¿Estás seguro?',
            text: "Esta acción no se puede revertir.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Sí, ¡eliminar!'
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/tickets/servicios/${ticketServicioId}`, {
                        method: 'DELETE',
                        headers: {
                            'CSRF-Token': csrfToken
                        }
                    });
                    const resData = await response.json();
                    if (resData.success) {
                        $(this).closest('tr').remove();
                        if ($('#servicesTableBody tr').length === 0) {
                            $('#servicesTableBody').html('<tr><td colspan="5" class="text-center text-muted">No hay servicios asociados a este ticket.</td></tr>');
                        }
                        if (resData.totales) {
                            $('#totalServiciosValue').text(monedaHNL.format(resData.totales.total_servicios || 0));
                            $('#totalCostosValue').text(monedaHNL.format(resData.totales.total_costos || 0));
                            $('#totalTicketValue').text(monedaHNL.format(resData.totales.total_ticket || 0));
                        }
                        Swal.fire({
                            icon: 'success',
                            title: 'Servicio eliminado',
                            timer: 1200,
                            showConfirmButton: false
                        });
                    } else { throw new Error(resData.error); }
                } catch (error) {
                    Swal.fire('Error', error.message || 'No se pudo eliminar el servicio.', 'error');
                }
            }
        });
    });

    // 6. Guardar edición de precio unitario sin recargar
    $('#servicesTableBody').on('click', '.save-price-btn', async function() {
        const ticketServicioId = $(this).data('id');
        const row = $(this).closest('tr');
        const priceInput = row.find(`.service-price-input[data-id="${ticketServicioId}"]`);
        const precioUnitario = Number(priceInput.val());

        if (!precioUnitario || precioUnitario <= 0) {
            Swal.fire('Atención', 'Ingrese un precio unitario válido.', 'warning');
            return;
        }

        try {
            const response = await fetch(`/tickets/servicios/${ticketServicioId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': csrfToken
                },
                body: JSON.stringify({ precio_unitario: precioUnitario })
            });
            const result = await response.json();
            if (!response.ok || !result.success) {
                throw new Error(result.error || 'No se pudo actualizar el precio.');
            }

            if (result.item) {
                row.find(`.service-subtotal[data-id="${ticketServicioId}"]`).text(monedaHNL.format(result.item.subtotal || 0));
                priceInput.val(Number(result.item.precio_unitario).toFixed(2));
            }
            if (result.totales) {
                $('#totalServiciosValue').text(monedaHNL.format(result.totales.total_servicios || 0));
                $('#totalCostosValue').text(monedaHNL.format(result.totales.total_costos || 0));
                $('#totalTicketValue').text(monedaHNL.format(result.totales.total_ticket || 0));
            }

            Swal.fire({
                icon: 'success',
                title: 'Precio actualizado',
                timer: 1100,
                showConfirmButton: false
            });
        } catch (error) {
            Swal.fire('Error', error.message, 'error');
        }
    });

    // 4. Agregar costo operativo manual
    $('#addCostForm').on('submit', async function(e) {
        e.preventDefault();
        const formData = new URLSearchParams(new FormData(this));
        try {
            const response = await fetch('/tickets/<%= ticket.id %>/costos', {
                method: 'POST',
                body: formData,
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'CSRF-Token': csrfToken
                }
            });
            const result = await response.json();
            if (!response.ok || !result.success) {
                throw new Error(result.error || 'No se pudo agregar el costo.');
            }
            const c = result.costo;
            const tbody = $('#costsTableBody');
            const emptyRow = tbody.find('tr td[colspan="3"]');
            if (emptyRow.length) {
                emptyRow.closest('tr').remove();
            }

            const rowHtml = `
                <tr>
                    <td>${c.descripcion}</td>
                    <td class="text-end">${monedaHNL.format(c.monto)}</td>
                    <td class="text-center">
                        <button class="btn btn-xs btn-outline-danger remove-cost-btn" data-id="${c.id}" title="Eliminar">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            tbody.prepend(rowHtml);

            if (result.totales) {
                $('#totalServiciosValue').text(monedaHNL.format(result.totales.total_servicios || 0));
                $('#totalCostosValue').text(monedaHNL.format(result.totales.total_costos || 0));
                $('#totalTicketValue').text(monedaHNL.format(result.totales.total_ticket || 0));
            }

            this.reset();
            Swal.fire({
                icon: 'success',
                title: 'Costo agregado',
                timer: 1200,
                showConfirmButton: false
            });
        } catch (error) {
            Swal.fire('Error', error.message, 'error');
        }
    });

    // 5. Eliminar costo operativo
    $('#costsTableBody').on('click', '.remove-cost-btn', function() {
        const costoId = $(this).data('id');
        Swal.fire({
            title: 'Eliminar costo',
            text: 'Esta accion no se puede revertir.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Si, eliminar'
        }).then(async (result) => {
            if (!result.isConfirmed) return;
            try {
                const response = await fetch(`/tickets/costos/${costoId}`, {
                    method: 'DELETE',
                    headers: {
                        'CSRF-Token': csrfToken
                    }
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.error || 'No se pudo eliminar el costo.');
                }
                $(this).closest('tr').remove();
                if ($('#costsTableBody tr').length === 0) {
                    $('#costsTableBody').html('<tr><td colspan="3" class="text-center text-muted">No hay costos operativos registrados.</td></tr>');
                }
                if (data.totales) {
                    $('#totalServiciosValue').text(monedaHNL.format(data.totales.total_servicios || 0));
                    $('#totalCostosValue').text(monedaHNL.format(data.totales.total_costos || 0));
                    $('#totalTicketValue').text(monedaHNL.format(data.totales.total_ticket || 0));
                }
                Swal.fire({
                    icon: 'success',
                    title: 'Costo eliminado',
                    timer: 1200,
                    showConfirmButton: false
                });
            } catch (error) {
                Swal.fire('Error', error.message, 'error');
            }
        });
    });
});
</script>
