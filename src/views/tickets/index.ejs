<%- include('../partials/header') %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestión de Tickets</h1>
        <a href="/tickets/nuevo" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Ticket
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table id="ticketsTable" class="table table-striped table-hover" width="100%">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Asunto</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Prioridad</th>
                            <th>Fecha de Creación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tickets.forEach(ticket => { %>
                            <tr>
                                <td>
                                    <a href="/tickets/<%= ticket.id %>"><%= ticket.ticket_codigo %></a>
                                </td>
                                <td><%= ticket.asunto %></td>
                                <td><%= ticket.cliente_nombre %> <%= ticket.cliente_apellido %></td>
                                <td>
                                    <% if (ticket.estado === 'pendiente') { %>
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    <% } else if (ticket.estado === 'abierto') { %>
                                        <span class="badge bg-success">Abierto</span>
                                    <% } else if (ticket.estado === 'en_proceso') { %>
                                        <span class="badge bg-warning">En Proceso</span>
                                    <% } else if (ticket.estado === 'resuelto') { %>
                                        <span class="badge bg-info">Resuelto</span>
                                    <% } else if (ticket.estado === 'cerrado') { %>
                                        <span class="badge bg-secondary">Cerrado</span>
                                    <% } else { %>
                                        <span class="badge bg-dark"><%= ticket.estado %></span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (ticket.prioridad === 'baja') { %>
                                        <span class="badge bg-info">Baja</span>
                                    <% } else if (ticket.prioridad === 'media') { %>
                                        <span class="badge bg-primary">Media</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Alta</span>
                                    <% } %>
                                </td>
                                <td>
                                    <%= new Date(ticket.created_at).toLocaleString('es-HN') %>
                                </td>
                                <td>
                                    <a href="/tickets/<%= ticket.id %>" class="btn btn-sm btn-outline-primary" title="Ver Detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- DataTables CSS y JS -->
<link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

<script>
$(document).ready(function() {
    $('#ticketsTable').DataTable({
        language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
        },
        order: [[0, 'desc']],
        responsive: true
    });
});
</script>
