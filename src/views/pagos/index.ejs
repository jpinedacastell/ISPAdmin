<!DOCTYPE html>
<html lang="es">
<head>
    
</head>
<body>
    <%- include('../partials/header') %>


<div class="container-fluid px-4 py-5">
    <!-- Encabezado de la página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Gestión de Pagos y Gastos</h1>
            <p class="mb-0 text-muted">Registra y administra todas las salidas de dinero.</p>
        </div>
        <button class="btn btn-primary shadow-sm" id="nuevoPagoBtn">
            <i class="fas fa-plus fa-sm me-2"></i>Registrar Pago
        </button>
    </div>

    <!-- Tarjeta principal con la tabla -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-receipt me-2"></i>Historial de Pagos</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="pagosTable" class="table table-hover align-middle" width="100%">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                            <th>Monto</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Los datos se cargarán con DataTables -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Registrar/Editar Pago -->
<div class="modal fade" id="pagoModal" tabindex="-1" aria-labelledby="pagoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pagoModalLabel">Registrar Nuevo Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="pagoForm" novalidate>
                    <!-- Campo oculto para el ID del pago (para edición) -->
                    <input type="hidden" id="pagoId">
                    <input type="hidden" id="csrfToken" value="<%= csrfToken %>">
                    
                    <div class="mb-3">
                        <label for="pagoDescripcion" class="form-label">Descripción</label>
                        <input type="text" class="form-control" id="pagoDescripcion" placeholder="Ej: Pago de factura de energía eléctrica" required>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="pagoMonto" class="form-label">Monto (HNL)</label>
                            <div class="input-group">
                                <span class="input-group-text">L</span>
                                <input type="number" class="form-control" id="pagoMonto" placeholder="1500.00" step="0.01" required>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="pagoFecha" class="form-label">Fecha del Pago</label>
                            <input type="date" class="form-control" id="pagoFecha" required>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="pagoCategoria" class="form-label">Categoría</label>
                            <select class="form-select" id="pagoCategoria" required>
                                <option value="" disabled selected>Seleccione una categoría</option>
                                <option value="Servicios Públicos">Servicios Públicos (Luz, Agua, Internet)</option>
                                <option value="Salarios">Salarios y Planilla</option>
                                <option value="Materiales y Equipo">Materiales y Equipo</option>
                                <option value="Marketing y Publicidad">Marketing y Publicidad</option>
                                <option value="Alquiler">Alquiler de Local/Oficina</option>
                                <option value="Transporte">Transporte y Combustible</option>
                                <option value="Impuestos">Impuestos</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="pagoMetodo" class="form-label">Método de Pago</label>
                            <select class="form-select" id="pagoMetodo">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Transferencia Bancaria">Transferencia Bancaria</option>
                                <option value="Tarjeta de Crédito/Débito">Tarjeta de Crédito/Débito</option>
                                <option value="Cheque">Cheque</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="pagoReferencia" class="form-label">Referencia / N° de Factura (Opcional)</label>
                        <input type="text" class="form-control" id="pagoReferencia" placeholder="Ej: Factura #00123">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarPagoBtn">
                    <i class="fas fa-save me-2"></i>Guardar Pago
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
$(document).ready(function() {
    
    const pagoModal = new bootstrap.Modal(document.getElementById('pagoModal'));

    const table = $('#pagosTable').DataTable({
    ajax: {
        url: '/pagos/list',
        dataSrc: ''
    },
    columns: [
    {
        data: 'fecha_pago',
        render: function(data) {
            if (!data) return '';
            const fecha = new Date(data);
            const dia = fecha.getDate().toString().padStart(2, '0');
            const mes = (fecha.getMonth() + 1).toString().padStart(2, '0');
            const anio = fecha.getFullYear();
            return `${dia}/${mes}/${anio}`;
        }
    },
    { data: 'descripcion' },
    { data: 'categoria' },
    { 
        data: 'monto',
        render: function(data) {
            return 'L ' + parseFloat(data).toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    },
    {
        data: null,
        orderable: false,
        className: 'text-center',
        render: function(data, type, row) {
            return `
                <button class="btn btn-sm btn-outline-primary editar-pago" data-id="${row.id}" title="Editar">
                    <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger eliminar-pago" data-id="${row.id}" title="Eliminar">
                    <i class="fas fa-trash"></i>
                </button>
            `;
        }
    }
],
    language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
    order: [[0, 'desc']]
});

    // Abrir modal para un nuevo pago
    $('#nuevoPagoBtn').on('click', function() {
        $('#pagoForm')[0].reset();
        $('#pagoId').val('');
        $('#pagoModalLabel').text('Registrar Nuevo Pago');
        $('#pagoFecha').val(new Date().toISOString().slice(0, 10)); // Poner fecha actual por defecto
        pagoModal.show();
    });

    $('#guardarPagoBtn').on('click', async function() {
    const pagoId = $('#pagoId').val();
    const url = pagoId ? `/pagos/${pagoId}` : '/pagos';
    const method = pagoId ? 'PUT' : 'POST';

    const categoria = $('#pagoCategoria').val();
    if (!categoria) {
        Swal.fire({
            icon: 'warning',
            title: 'Categoría requerida',
            text: 'Por favor selecciona una categoría.'
        });
        return;
    }

    const data = {
        descripcion: $('#pagoDescripcion').val(),
        monto: $('#pagoMonto').val(),
        fecha_pago: $('#pagoFecha').val(),
        categoria: $('#pagoCategoria').val(),
        metodo_pago: $('#pagoMetodo').val(),
        referencia: $('#pagoReferencia').val()
    };
    

    const csrfToken = $('#csrfToken').val();

    try {
        const response = await fetch(url, {
            method,
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': csrfToken
            },
            body: JSON.stringify(data),
            credentials: 'include'
        });
        const result = await response.json();
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: '¡Guardado!',
                text: 'El pago ha sido registrado correctamente.',
                showConfirmButton: false,
                timer: 1500
            });
            pagoModal.hide();
            table.ajax.reload(); // Descomenta cuando la API esté conectada
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: result.message || 'No se pudo guardar el pago.'
            });
        }
    } catch (error) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'No se pudo conectar con el servidor.'
        });
    }
});

   $('#pagosTable').on('click', '.editar-pago', async function() {
    const pagoId = $(this).data('id');
    try {
        // Petición real al backend para obtener el pago
        const response = await fetch(`/pagos/${pagoId}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            },
            credentials: 'include'
        });
        if (!response.ok) throw new Error('No se pudo obtener el pago');
        const data = await response.json();

        $('#pagoId').val(data.id);
        $('#pagoDescripcion').val(data.descripcion);
        $('#pagoMonto').val(data.monto);
        $('#pagoFecha').val(data.fecha_pago ? data.fecha_pago.slice(0, 10) : '');
        $('#pagoCategoria').val(data.categoria);
        $('#pagoMetodo').val(data.metodo_pago);
        $('#pagoReferencia').val(data.referencia);

        $('#pagoModalLabel').text('Editar Pago');
        pagoModal.show();
    } catch (error) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'No se pudo cargar el pago para editar.'
        });
    }
});
$('#pagosTable').on('click', '.eliminar-pago', function() {
    const pagoId = $(this).data('id');
    const csrfToken = $('#csrfToken').val();

    Swal.fire({
        title: '¿Estás seguro?',
        text: "No podrás revertir esta acción.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, ¡eliminar!',
        cancelButtonText: 'Cancelar'
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const response = await fetch(`/pagos/${pagoId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken
                    },
                    credentials: 'include'
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire(
                        '¡Eliminado!',
                        'El pago ha sido eliminado.',
                        'success'
                    );
                    table.ajax.reload();
                } else {
                    throw new Error(data.error || 'No se pudo eliminar el pago.');
                }
            } catch (error) {
                Swal.fire(
                    'Error',
                    error.message || 'No se pudo eliminar el pago.',
                    'error'
                );
            }
        }
    });
});

});
</script>

</body>
</html>
