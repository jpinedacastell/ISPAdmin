                                        // Mostrar el mes y año (ej. "diciembre 2024")
                                        %>
                                        <%= mesFacturado.toLocaleString('es-ES', opciones) %>
                                        
                                        <!-- Mostrar badge si es facturación adelantada -->
                                        <% if (new Date(factura.mes_facturado) > new Date()) { %>
                                            <span class="badge bg-info">Mes futuro</span>
                                        <% } else if (new Date(factura.mes_facturado) < new Date()) { %>
                                        <% } %>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invoice Items -->
            <div class="invoice-details mb-4">
                <div class="table-responsive">
                    <table class="table invoice-items">
                        <thead>
                            <tr>
                                <th class="bg-light-primary">Descripción</th>
                                <th class="bg-light-primary text-center" width="100">Unidades</th>
                                <th class="bg-light-primary text-end" width="120">Precio Unitario</th>
                                <th class="bg-light-primary text-end" width="120">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <strong><%= factura.plan_nombre %></strong>
                                    <div class="text-muted small">Servicio de internet - <%= mesFacturado.toLocaleString('es-ES', opciones) %></div>
                                </td>
                                <td class="text-center">1</td>
                                <td class="text-end">L <%= parseFloat(factura.monto).toFixed(2) %></td>
                                <td class="text-end">L <%= parseFloat(factura.monto).toFixed(2) %></td>
                            </tr>
                            <tr class="divider-row">
                                <td colspan="4"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Action Buttons
            <div class="action-buttons">
                
                <button class="btn btn-success" onclick="openExtensionModal()">
                    <i class="fas fa-clock me-2"></i>Prorrogar Pago
                </button>
            </div> -->

            <!-- Discount Modal -->
            <div class="discount-modal" id="discountModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4>Aplicar Descuento</h4>
                        <span class="close-modal" onclick="closeDiscountModal()">&times;</span>
                    </div>
                    <div class="modal-form-group">
                        <label for="discountPercentage">Porcentaje de descuento:</label>
                        <input type="number" id="discountPercentage" min="0" max="100" step="0.1" required>
                    </div>
                    <div class="modal-form-group">
                         <label for="discountReason">Motivo del descuento:</label>
                        <textarea id="discountReason" rows="3" required></textarea>
                    </div>
                    <div class="modal-form-group">
                        <button class="btn btn-primary" onclick="applyDiscount()">Aplicar Descuento</button>
                        <button class="btn btn-secondary" onclick="closeDiscountModal()">Cancelar</button>
                    </div>
                </div>
            </div>

            <!-- Extension Modal -->
            <div class="extension-modal" id="extensionModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4>Prorrogar Pago</h4>
                        <span class="close-modal" onclick="closeExtensionModal()">&times;</span>
                    </div>
                    <div class="modal-form-group">
                        <label for="extensionDays">Días de prórroga:</label>
                        <input type="number" id="extensionDays" min="1" required>
                    </div>
                    <div class="modal-form-group">
                         <label for="extensionReason">Motivo de la prórroga:</label>
                        <textarea id="extensionReason" rows="3" required></textarea>
                    </div>
                    <div class="modal-form-group">
                        <button class="btn btn-success" onclick="applyExtension()">Prorrogar Pago</button>
                        <button class="btn btn-secondary" onclick="closeExtensionModal()">Cancelar</button>
                    </div>
                </div>
            </div>

            <!-- Totals and Payment Info -->
            <div class="row">
                <div class="col-md-6">
                    <div class="payment-notes">
                        <h5 class="section-title"><i class="fas fa-info-circle me-2"></i>Notas</h5>
                        <ul>
                            <li>El pago debe realizarse antes de la fecha de vencimiento</li>
                            <li>Para cualquier consulta, contacte a nuestro servicio al cliente</li>
                            <li>Conserve este documento para futuras referencias</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="invoice-totals-card">
                        <table class="table totals-table">
                            <tr>
                                <td>Subtotal:</td>
                                <td class="text-end">L <%= parseFloat(factura.monto).toFixed(2) %></td>
                            </tr>
                            <% 
                                // Manejar descuento único
                                if (factura.descuento_porcentaje > 0) { 
                            %>
                                <tr>
                                    <td>Descuento:</td>
                                    <td class="text-end">L <%= parseFloat(factura.descuento_monto).toFixed(2) %></td>
                                </tr>
                                <tr>
                                    <td class="text-muted ps-4">- <%= factura.motivo_descuento %></td>
                                    <td class="text-end text-muted">(<%= factura.descuento_porcentaje %>%)</td>
                                </tr>
                            <% } else { %>
                                <tr>
                                    <td>Descuento:</td>
                                    <td class="text-end">L 0.00</td>
                                </tr>
                            <% } %>
                                <tr>
                                    <td>Total factura:</td>
                                    <td class="text-end">L <%= totalFactura.toFixed(2) %></td>
                                </tr>
                                <% if (creditoAplicado > 0) { %>
                                <tr>
                                    <td>Saldo a favor aplicado:</td>
                                    <td class="text-end text-success">- L <%= creditoAplicado.toFixed(2) %></td>
                                </tr>
                                <% } %>
                                <% if (montoPagado > 0) { %>
                                <tr>
                                    <td>Pago aplicado:</td>
                                    <td class="text-end text-success">- L <%= montoPagado.toFixed(2) %></td>
                                </tr>
                                <% } %>
                                <% if (abonoSiguiente > 0) { %>
                                <tr>
                                    <td>Abono a próximas facturas:</td>
                                    <td class="text-end text-info">L <%= abonoSiguiente.toFixed(2) %></td>
                                </tr>
                                <% } %>
	                            <tr class="total-row">
	                                <td><strong>SALDO:</strong></td>
	                                <td class="text-end"><strong>L <%= saldoPendiente.toFixed(2) %></strong></td>
	                            </tr>
                            <% if(factura.estado === 'pagada') { %>
                                <tr class="paid-row">
                                    <td colspan="2" class="text-center text-success">
                                        <i class="fas fa-check-circle me-2"></i> PAGADO
                                    </td>
                                </tr>
                            <% } else { %>
                                <tr class="pending-row">
                                    <td colspan="2" class="text-center text-warning">
                                        <i class="fas fa-exclamation-circle me-2"></i> PENDIENTE
                                    </td>
                                </tr>
                            <% } %>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Promoción de Referidos -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="referral-card">
                        <div class="referral-content">
                            <div class="referral-icon">
                                <i class="fas fa-gift"></i>
                            </div>
                            <div class="referral-text">
                                <h3>¡GANA 1 MES GRATIS!</h3>
                                <p>Por cada amigo que refieras y se suscriba a nuestro servicio</p>
                                <div class="referral-features">
                                    <span><i class="fas fa-check-circle"></i> Sin límite de referidos</span>
                                    <span><i class="fas fa-check-circle"></i> Acumulable</span>
                                    <span><i class="fas fa-check-circle"></i> Sin condiciones</span>
                                </div>
                            
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="invoice-footer mt-4 pt-3 border-top">
                <div class="row">
                    <div class="col-md-6">
                        <p class="small text-muted mb-1">Este documento es un comprobante electrónico válido</p>
                        <p class="small text-muted mb-0">No requiere firma ni sello</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="small text-muted mb-0">Generado el: <%= new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function waitForPdfLayout() {
    return new Promise((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(resolve));
    });
}

function waitForInvoiceImages(element) {
    const images = Array.from(element.querySelectorAll('img'));

    return Promise.all(images.map((image) => {
        if (image.complete) {
            return Promise.resolve();
        }

        return new Promise((resolve) => {
            image.addEventListener('load', resolve, { once: true });
            image.addEventListener('error', resolve, { once: true });
        });
    }));
}

function getPdfConstructor() {
    if (window.jspdf && window.jspdf.jsPDF) {
        return window.jspdf.jsPDF;
    }

    if (window.jsPDF) {
        return window.jsPDF;
    }

    return null;
}

const reciboPdfFilename = <%- JSON.stringify(mesFacturado.toLocaleString('es-ES', opciones) + ' - ' + factura.cliente_nombre + ' ' + factura.cliente_apellido + ' - ' + factura.numero_factura + '.pdf') %>;
const reciboShareTitle = <%- JSON.stringify('Recibo ' + sistema.empresa.nombre + ' ' + factura.numero_factura) %>;
const reciboShareText = <%- JSON.stringify('Hola ' + (factura.cliente_nombre || '') + ', le comparto su recibo de ' + sistema.empresa.nombre + ' ' + factura.numero_factura + '.') %>;
const clienteWhatsAppTelefono = <%- JSON.stringify(factura.cliente_telefono || '') %>;
const saldoFacturaActual = <%= JSON.stringify(Number(saldoPendiente.toFixed(2))) %>;

function setPdfButtonsDisabled(disabled) {
    const downloadButton = document.getElementById('downloadPdfBtn');
    const shareButton = document.getElementById('sharePdfBtn');

    if (downloadButton) {
        downloadButton.disabled = disabled;
    }

    if (shareButton) {
        shareButton.disabled = disabled;
    }
}

function getHtml2PdfOptions() {
    return {
        margin: 0.25,
        filename: reciboPdfFilename,
        image: { type: 'jpeg', quality: 0.99 },
        html2canvas: {
            scale: 2,
            useCORS: true
        },
        jsPDF: {
            unit: 'cm',
            format: 'a4',
            orientation: 'portrait'
        }
    };
}

async function crearPdfRecibo(allowDownloadFallback = false) {
    const element = document.querySelector('.premium-invoice');

    if (!element) {
        throw new Error('No se encontró el comprobante para generar el PDF.');
    }

    document.body.classList.add('pdf-generating');

    try {
        await waitForInvoiceImages(element);
        await waitForPdfLayout();

        const PdfConstructor = getPdfConstructor();

        if (!PdfConstructor || typeof html2canvas !== 'function') {
            if (allowDownloadFallback && typeof html2pdf === 'function') {
                await html2pdf().set(getHtml2PdfOptions()).from(element).save();
                return null;
            }

            throw new Error('El navegador no pudo cargar las librerías para compartir el PDF.');
        }

        const canvas = await html2canvas(element, {
            scale: 2,
            useCORS: true,
            allowTaint: true,
            backgroundColor: '#ffffff',
            windowWidth: Math.max(1200, element.scrollWidth),
            scrollX: 0,
            scrollY: -window.scrollY
        });

        const pdf = new PdfConstructor({
            orientation: 'portrait',
            unit: 'cm',
            format: 'a4',
            compress: true
        });
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();
        const margin = 0.35;
        const maxWidth = pageWidth - (margin * 2);
        const maxHeight = pageHeight - (margin * 2);
        let imageWidth = maxWidth;
        let imageHeight = (canvas.height * imageWidth) / canvas.width;

        if (imageHeight > maxHeight) {
            imageHeight = maxHeight;
            imageWidth = (canvas.width * imageHeight) / canvas.height;
        }

        const imageX = (pageWidth - imageWidth) / 2;
        const imageY = margin;
        const imageData = canvas.toDataURL('image/jpeg', 0.98);

        pdf.addImage(imageData, 'JPEG', imageX, imageY, imageWidth, imageHeight, undefined, 'FAST');
        return pdf;
    } finally {
        document.body.classList.remove('pdf-generating');
    }
}

async function crearArchivoPdfRecibo() {
    if (typeof File !== 'function') {
        throw new Error('file-share-not-supported');
    }

    const pdf = await crearPdfRecibo(false);
    const pdfBlob = pdf.output('blob');

    return new File([pdfBlob], reciboPdfFilename, { type: 'application/pdf' });
}

function puedeCompartirArchivo(file) {
    if (!navigator.share) {
        return false;
    }

    if (navigator.canShare) {
        return navigator.canShare({ files: [file] });
    }

    return true;
}

async function compartirArchivoRecibo(file) {
    if (!puedeCompartirArchivo(file)) {
        throw new Error('file-share-not-supported');
    }

    await navigator.share({
        title: reciboShareTitle,
        text: reciboShareText,
        files: [file]
    });
}

function normalizarTelefonoWhatsApp(phone) {
    const digits = String(phone || '').replace(/\D/g, '');

    if (digits.length === 8) {
        return `504${digits}`;
    }

    return digits;
}

function abrirWhatsAppConTexto() {
    const phone = normalizarTelefonoWhatsApp(clienteWhatsAppTelefono);
    const message = `${reciboShareText}\n\nRecibo: ${reciboPdfFilename}`;
    const url = phone
        ? `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
        : `https://wa.me/?text=${encodeURIComponent(message)}`;

    window.open(url, '_blank');
}

async function pedirSegundoToqueParaCompartir(file) {
    const result = await Swal.fire({
        icon: 'info',
        title: 'PDF listo',
        text: 'Toca Compartir ahora y elige WhatsApp para enviarlo como adjunto.',
        showCancelButton: true,
        confirmButtonText: 'Compartir ahora',
        cancelButtonText: 'Cancelar'
    });

    if (result.isConfirmed) {
        try {
            await compartirArchivoRecibo(file);
        } catch (error) {
            if (error.name !== 'AbortError') {
                throw error;
            }
        }
    }
}

async function generarPDF() {
    setPdfButtonsDisabled(true);

    try {
        const pdf = await crearPdfRecibo(true);

        if (pdf) {
            pdf.save(reciboPdfFilename);
        }
    } catch (error) {
        console.error('Error al generar PDF:', error);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'No se pudo generar el PDF. Inténtalo de nuevo.'
        });
    } finally {
        setPdfButtonsDisabled(false);
    }
}

async function enviarPDFWhatsApp() {
    setPdfButtonsDisabled(true);

    try {
        const pdfFile = await crearArchivoPdfRecibo();

        try {
            await compartirArchivoRecibo(pdfFile);
        } catch (shareError) {
            if (shareError.name === 'AbortError') {
                return;
            }

            if (shareError.name === 'NotAllowedError') {
                await pedirSegundoToqueParaCompartir(pdfFile);
                return;
            }

            throw shareError;
        }
    } catch (error) {
        console.error('Error al compartir PDF:', error);

        if (error.name === 'AbortError') {
            return;
        }

        if (error.message === 'file-share-not-supported' || error.name === 'TypeError') {
            const result = await Swal.fire({
                icon: 'info',
                title: 'Compartir PDF no disponible',
                text: 'Este navegador no permite adjuntar el PDF directo. Puedo abrir WhatsApp con el mensaje para el cliente.',
                showCancelButton: true,
                confirmButtonText: 'Abrir WhatsApp',
                cancelButtonText: 'Cancelar'
            });

            if (result.isConfirmed) {
                abrirWhatsAppConTexto();
            }

            return;
        }

        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'No se pudo preparar el recibo para WhatsApp. Inténtalo de nuevo.'
        });
    } finally {
        setPdfButtonsDisabled(false);
    }
}

// Add data labels for responsive tables
document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('.invoice-items tbody td');
    const labels = ['Descripción', 'Unidades', 'Precio Unitario', 'Total'];
    
    items.forEach((td, index) => {
        td.setAttribute('data-label', labels[index % labels.length]);
    });
});

// LÓGICA PARA REGISTRAR PAGO
async function registrarPago() {
    const facturaId = <%= factura.id %>;
    const { value: formValues } = await Swal.fire({
        title: 'Registrar Pago',
        html: `
            <div class="alert alert-light border text-start py-2">
                <div><strong>Saldo pendiente:</strong> L ${saldoFacturaActual.toFixed(2)}</div>
                <small class="text-muted">Si recibe más del saldo, el excedente queda como abono para próximas facturas.</small>
            </div>
            <div class="mb-3 text-start">
                <label class="form-label">Monto recibido</label>
                <input id="montoRecibido" type="number" min="0.01" step="0.01" class="form-control" value="${saldoFacturaActual.toFixed(2)}">
            </div>
            <div class="mb-3 text-start">
                <label class="form-label">Método de Pago</label>
                <select id="metodoPago" class="form-select">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                    <option value="Tarjeta">Tarjeta</option>
                </select>
            </div>
        `,
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonText: 'Registrar',
        cancelButtonText: 'Cancelar',
        preConfirm: () => {
            const montoRecibido = parseFloat(document.getElementById('montoRecibido').value);

            if (!Number.isFinite(montoRecibido) || montoRecibido <= 0) {
                Swal.showValidationMessage('Ingrese un monto recibido mayor a cero');
                return false;
            }

            return {
                metodo_pago: document.getElementById('metodoPago').value,
                monto_recibido: montoRecibido
            }
        }
    });

    if (formValues) {
        try {
            const response = await fetch(`/facturacion/${facturaId}/pago`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify(formValues)
            });

            const result = await response.json();

            if (result.success) {
                const abono = Number(result.data?.abono_generado || 0);
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: abono > 0
                        ? `Pago registrado. Abono a favor: L ${abono.toFixed(2)}`
                        : 'Pago registrado correctamente',
                    showConfirmButton: false,
                    timer: 2200
                }).then(() => {
                    location.reload();
                });
            } else {
                throw new Error(result.error || 'Error al registrar el pago');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'No se pudo registrar el pago'
            });
        }
    }
}
</script>

