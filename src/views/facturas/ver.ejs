    padding-top: 0.3rem !important;
}

/* Estilos para la tarjeta de referidos */
.referral-card {
    background: linear-gradient(135deg, #4e54c8 0%, #8f94fb 100%);
    border-radius: 12px;
    padding: 12px;
    color: white;
    box-shadow: 0 10px 20px rgba(78, 84, 200, 0.2);
    margin-bottom: 10px;
    position: relative;
    overflow: hidden;
}

.referral-card::before {
    content: '';
