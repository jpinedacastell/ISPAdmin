<%- include('../partials/header') %>

<!-- Agregar las librerías necesarias -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Almacenar el ID de la factura
    const facturaId = <%= JSON.stringify(factura.id) %>;

    // Funciones para manejar los modales
    function openDiscountModal() {
        document.getElementById('discountModal').style.display = 'block';
    }

    
    function closeDiscountModal() {
        document.getElementById('discountModal').style.display = 'none';
        document.getElementById('discountPercentage').value = '';
        document.getElementById('discountReason').value = '';
    }

    function openExtensionModal() {
        document.getElementById('extensionModal').style.display = 'block';
    }

    function closeExtensionModal() {
        document.getElementById('extensionModal').style.display = 'none';
        document.getElementById('extensionDays').value = '';
        document.getElementById('extensionReason').value = '';
    }

    // Funciones para aplicar descuentos y prórrogas
    async function applyDiscount() {
        const percentage = document.getElementById('discountPercentage').value;
        const reason = document.getElementById('discountReason').value;
        
        try {
            const response = await fetch('/facturacion/descuento', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({
                    idFactura: JSON.parse(facturaId),
                    porcentaje: percentage,
                    motivo: reason
                })
            });

            const data = await response.json();
            
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: 'Descuento aplicado correctamente'
                }).then(() => {
                    location.reload();
                });
            } else if (data.message === 'Ya existe un descuento aplicado a esta factura') {
                Swal.fire({
                    icon: 'warning',
                    title: '¡Atención!',
                    text: 'Ya existe un descuento aplicado a esta factura. No se puede aplicar otro descuento.'
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Error al aplicar descuento'
                });
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error al procesar la solicitud'
            });
        }
    }

    async function applyExtension() {
        const days = document.getElementById('extensionDays').value;
        const reason = document.getElementById('extensionReason').value;
        
        try {
            const response = await fetch('/facturacion/prorroga', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({
                    idFactura: JSON.parse(facturaId),
                    dias: days,
                    motivo: reason
                })
            });

            const data = await response.json();
            
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: 'Prórroga aplicada correctamente'
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Error al aplicar prórroga'
                });
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error al procesar la solicitud'
            });
        }
    }
</script>


