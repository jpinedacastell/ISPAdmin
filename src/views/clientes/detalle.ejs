<%- include('../partials/header') %>

<div class="container-fluid px-4">
    <!-- Título y botones de acción -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><%= cliente.nombre %></h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/clientes">Clientes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detalles</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-warning editar-cliente" data-cliente-id="<%= cliente.id %>">
                <i class="fas fa-edit"></i> Editar
            </button>
            <button onclick="eliminarCliente(<%= cliente.id %>)" class="btn btn-danger">
                <i class="fas fa-trash"></i> Eliminar
            </button>
        </div>
    </div>

    <div class="row">
        <!-- Información del Cliente -->
        <div class="col-xl-4 col-lg-5">
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user mr-1"></i>
                        Información del Cliente
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="small text-muted">Email</label>
                        <div><%= cliente.email %></div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted">Teléfono</label>
                        <div><%= cliente.telefono %></div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted">Dirección</label>
                        <div><%= cliente.direccion %></div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted">Plan Actual</label>
                        <div>
                            <% if (cliente.plan_nombre) { %>
                                <%= cliente.plan_nombre %> 
                                <br>
                                <small class="text-muted">
                                    ↓<%= cliente.velocidad_descarga %>Mbps ↑<%= cliente.velocidad_subida %>Mbps
                                    <br>
                                    $<%= cliente.precio %> mensuales
                                </small>
                            <% } else { %>
                                Sin plan activo
                            <% } %>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted">Estado de Plan</label>
                        <div>
                            <% if (cliente.activo !== undefined && cliente.activo !== null) { %>
                                <span class="badge <%= cliente.activo ? 'bg-success' : 'bg-danger' %>">
                                    <%= cliente.activo ? 'Activo' : 'Inactivo' %>
                                </span>
                            <% } else { %>
                                <span class="badge bg-secondary">Sin plan</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted">Cliente desde</label>
                        <div>
                            <% if (cliente.fecha_inicio) { %>
                                <%= new Date(cliente.fecha_inicio).toLocaleDateString() %>
                            <% } else { %>
                                No disponible
                            <% } %>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted">Estado de Pago</label>
                        <div>
                            <% 
                            let badgeClass = '';
                            let estadoTexto = '';
                            
                            switch(estadoPago.estado_pago) {
                                case 'al_dia':
                                    badgeClass = 'bg-success';
                                    estadoTexto = 'Al día';
                                    break;
                                case 'pendiente':
                                    badgeClass = 'bg-warning text-dark';
                                    estadoTexto = 'Pendiente';
                                    break;
                                case 'moroso':
                                    badgeClass = 'bg-danger';
                                    estadoTexto = 'Moroso';
                                    break;
                                case 'sin_facturas':
                                    badgeClass = 'bg-secondary';
                                    estadoTexto = 'Sin facturas';
                                    break;
                            }
                            %>
                            <span class="badge <%= badgeClass %>"><%= estadoTexto %></span>
                            <% if (estadoPago.total_facturas > 0) { %>
                                <div class="mt-2 small text-muted">
                                    <div>Total facturas: <%= estadoPago.total_facturas %></div>
                                    <div>Pagadas: <%= estadoPago.facturas_pagadas %></div>
                                    <% if (estadoPago.facturas_pendientes > 0) { %>
                                        <div>Pendientes: <%= estadoPago.facturas_pendientes %></div>
                                    <% } %>
                                    <% if (estadoPago.facturas_vencidas > 0) { %>
                                        <div>Vencidas: <%= estadoPago.facturas_vencidas %></div>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pestañas de Información -->
        <div class="col-xl-8 col-lg-7">
            <div class="card mb-4">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active text-dark" data-bs-toggle="tab" href="#facturas" role="tab">
                                <i class="fas fa-file-invoice-dollar me-1"></i> Facturas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" data-bs-toggle="tab" href="#tickets" role="tab">
                                <i class="fas fa-ticket-alt me-1"></i> Tickets
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" data-bs-toggle="tab" href="#notas" role="tab">
                                <i class="fas fa-sticky-note me-1"></i> Notas
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- Facturas -->
                        <div class="tab-pane fade show active" id="facturas" role="tabpanel">
                            <!-- Resumen de Pagos por Mes -->
                            <div class="mb-4">
                                <% 
                                // Obtener el año más reciente de las facturas o usar el año actual si no hay facturas
                                let añoMostrado = añoSeleccionado || new Date().getFullYear();

                                // Agregar selector de año
                                const años = [...new Set(facturas.map(f => f.año_facturado))].sort((a, b) => b - a);
                                %>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0">Resumen de Pagos</h5>
                                    <div class="d-flex align-items-center">
                                        <% if (años.length > 1) { %>
                                            <select class="form-select form-select-sm me-2" id="selectorAño" style="width: auto;">
                                                <% años.forEach(año => { %>
                                                    <option value="<%= año %>" <%= año === añoMostrado ? 'selected' : '' %>><%= año %></option>
                                                <% }); %>
                                            </select>
                                        <% } else { %>
                                            <h5 class="mb-0"><%= añoMostrado %></h5>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <% 
                                    const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 
                                                 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
                                    const hoy = new Date();
                                    const mesActual = hoy.getMonth();
                                    const añoActual = hoy.getFullYear();

                                    // Crear mapa de facturas por mes para el año seleccionado
                                    const facturasPorMes = new Map();
                                    facturas.forEach(factura => {
                                        if (factura.año_facturado === añoMostrado) {
                                            const mes = factura.mes_facturado_index - 1;
                                            facturasPorMes.set(mes, factura);
                                        }
                                    });

                                    meses.forEach((mes, index) => {
                                        const factura = facturasPorMes.get(index);
                                        let badgeClass = 'bg-secondary';
                                        let estado = 'Pendiente de generar';
                                        
                                        if (factura) {
                                            switch(factura.estado) {
                                                case 'pagada':
                                                    badgeClass = 'bg-success';
                                                    estado = 'Pagado';
                                                    break;
                                                case 'pendiente':
                                                    badgeClass = 'bg-warning text-dark';
                                                    estado = 'Pendiente de pago';
                                                    break;
                                                case 'vencida':
                                                    badgeClass = 'bg-danger';
                                                    estado = 'Vencida';
                                                    break;
                                            }
                                        } else {
                                            if (añoMostrado === añoActual) {
                                                if (index < mesActual - 1) {
                                                    badgeClass = 'bg-danger';
                                                    estado = 'No generada';
                                                } else if (index === mesActual - 1) {
                                                    badgeClass = 'bg-warning text-dark';
                                                    estado = 'Pendiente de generar';
                                                } else if (index === mesActual) {
                                                    badgeClass = 'bg-info';
                                                    estado = 'Mes actual';
                                                } else {
                                                    badgeClass = 'bg-secondary';
                                                    estado = 'Mes futuro';
                                                }
                                            } else if (añoMostrado < añoActual) {
                                                badgeClass = 'bg-danger';
                                                estado = 'No generada';
                                            } else {
                                                badgeClass = 'bg-secondary';
                                                estado = 'Mes futuro';
                                            }
                                        }
                                    %>
                                    <div class="card" style="width: 150px;">
                                        <div class="card-body p-2 text-center">
                                            <h6 class="card-title mb-2"><%= mes %></h6>
                                            <span class="badge <%= badgeClass %>"><%= estado %></span>
                                            <% if (factura) { %>
                                                <div class="mt-2">
                                                    <small class="d-block">L <%= parseFloat(factura.monto).toFixed(2) %></small>
                                                    <% if (Number(factura.saldo_pendiente || 0) > 0 && (Number(factura.monto_pagado || 0) + Number(factura.credito_aplicado || 0)) > 0) { %>
                                                        <small class="d-block text-warning">Saldo: L <%= Number(factura.saldo_pendiente || 0).toFixed(2) %></small>
                                                    <% } %>
                                                    <a href="/facturacion/<%= factura.id %>/ver" class="btn btn-sm btn-info" title="Ver Factura">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                                </div>
                            </div>

                            <!-- Tabla de Facturas -->
                            <h5 class="mb-3">Historial de Facturas</h5>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Mes Facturado</th>
                                            <th>Fecha Emisión</th>
                                            <th>Vencimiento</th>
                                            <th>Monto</th>
                                            <th>Estado</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% facturas.forEach(function(factura) { %>
                                            <tr>
                                                <td><%= factura.id %></td>
                                                <td>
                                                    <% 
                                                    const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 
                                                                        'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
                                                    const mesIndex = factura.mes_facturado_index - 1;
                                                    %>
                                                    <%= mesesNombres[mesIndex] %> <%= factura.año_facturado %>
                                                </td>
                                                <td><%= new Date(factura.fecha_emision).toLocaleDateString() %></td>
                                                <td><%= new Date(factura.fecha_vencimiento).toLocaleDateString() %></td>
                                                <td>
                                                    L <%= parseFloat(factura.monto).toFixed(2) %>
                                                    <% if ((Number(factura.monto_pagado || 0) + Number(factura.credito_aplicado || 0)) > 0 && Number(factura.saldo_pendiente || 0) > 0) { %>
                                                        <small class="d-block text-success">Abonado: L <%= (Number(factura.monto_pagado || 0) + Number(factura.credito_aplicado || 0)).toFixed(2) %></small>
                                                        <small class="d-block text-warning">Saldo: L <%= Number(factura.saldo_pendiente || 0).toFixed(2) %></small>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% 
                                                    let estadoClass = '';
                                                    switch(factura.estado) {
                                                        case 'pagada':
                                                            estadoClass = 'success';
                                                            break;
                                                        case 'pendiente':
                                                            estadoClass = 'warning';
                                                            break;
                                                        case 'vencida':
                                                            estadoClass = 'danger';
                                                            break;
                                                    }
                                                    %>
                                                    <% if (factura.estado !== 'pagada' && (Number(factura.monto_pagado || 0) + Number(factura.credito_aplicado || 0)) > 0) { %>
                                                        <span class="badge bg-info">abonada</span>
                                                    <% } else { %>
                                                        <span class="badge bg-<%= estadoClass %>"><%= factura.estado %></span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="/facturacion/<%= factura.id %>/ver" class="btn btn-sm btn-info" title="Ver Factura">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <% if (factura.estado !== 'pagada') { %>
                                                            <button class="btn btn-sm btn-success registrar-pago" 
                                                                    data-factura-id="<%= factura.id %>"
                                                                    data-saldo="<%= Number(factura.saldo_pendiente || factura.monto || 0).toFixed(2) %>"
                                                                    title="Registrar Pago">
                                                                <i class="fas fa-money-bill"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Tickets -->
                        <div class="tab-pane fade" id="tickets" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Asunto</th>
                                            <th>Fecha</th>
                                            <th>Estado</th>
                                            <th>Prioridad</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% tickets.forEach(function(ticket) { %>
                                            <tr>
                                                <td><%= ticket.id %></td>
                                                <td><%= ticket.asunto %></td>
                                                <td><%= new Date(ticket.fecha_creacion).toLocaleDateString() %></td>
                                                <td>
                                                    <% 
                                                    let ticketClass = '';
                                                    switch(ticket.estado) {
                                                        case 'abierto':
                                                            ticketClass = 'info';
                                                            break;
                                                        case 'en_proceso':
                                                            ticketClass = 'warning';
                                                            break;
                                                        case 'resuelto':
                                                            ticketClass = 'success';
                                                            break;
                                                        case 'cerrado':
                                                            ticketClass = 'secondary';
                                                            break;
                                                    }
                                                    %>
                                                    <span class="badge bg-<%= ticketClass %>">
                                                        <%= ticket.estado.replace('_', ' ') %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <% 
                                                    let prioridadClass = '';
                                                    switch(ticket.prioridad) {
                                                        case 'alta':
                                                            prioridadClass = 'danger';
                                                            break;
                                                        case 'media':
                                                            prioridadClass = 'warning';
                                                            break;
                                                        case 'baja':
                                                            prioridadClass = 'success';
                                                            break;
                                                    }
                                                    %>
                                                    <span class="badge bg-<%= prioridadClass %>"><%= ticket.prioridad %></span>
                                                </td>
                                                <td>
                                                    <a href="/tickets/<%= ticket.id %>" class="btn btn-sm btn-info">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Notas -->
                        <div class="tab-pane fade" id="notas" role="tabpanel">
                            <div class="mb-3">
                                <button class="btn btn-primary" onclick="agregarNota()">
                                    <i class="fas fa-plus"></i> Nueva Nota
                                </button>
                            </div>
                            <div class="list-group">
                                <% notas.forEach(function(nota) { %>
                                    <div class="list-group-item">
                                        <div class="d-flex w-100 justify-content-between">
                                            <small class="text-muted">
                                                <%= new Date(nota.fecha_creacion).toLocaleString() %>
                                            </small>
                                            <button class="btn btn-sm btn-danger" onclick="eliminarNota(<%= nota.id %>)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                        <p class="mb-1"><%= nota.nota %></p>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Edición -->
<div class="modal fade" id="editarClienteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editarClienteForm">
                    <input type="hidden" id="clienteId" value="<%= cliente.id %>">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="editNombre" value="<%= cliente.nombre %>" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editApellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="editApellido" value="<%= cliente.apellido %>" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editDni" class="form-label">DNI</label>
                            <input type="text" class="form-control" id="editDni" value="<%= cliente.dni %>" required
                                   pattern="\d{13}"
                                   maxlength="13"
                                   title="DNI debe tener 13 dígitos numéricos">
                            <div class="form-text">Formato: 13 dígitos numéricos (ejemplo: 1601199800012)</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="editEmail" value="<%= cliente.email %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editTelefono" class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" id="editTelefono" value="<%= cliente.telefono %>">
                        </div>
                        <div class="col-md-6">
                            <label for="editPlan" class="form-label">Plan</label>
                            <select class="form-select" id="editPlan">
                                <option value="">Sin plan</option>
                                <!-- Los planes se cargarán dinámicamente -->
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editDireccion" class="form-label">Dirección</label>
                        <textarea class="form-control" id="editDireccion" rows="2"><%= cliente.direccion %></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarCambios">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- Custom JS -->
<script>
// Función para eliminar cliente
function eliminarCliente(id) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: "Esta acción no se puede deshacer",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/clientes/${id}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire(
                        '¡Eliminado!',
                        'El cliente ha sido eliminado.',
                        'success'
                    ).then(() => {
                        window.location.href = '/clientes';
                    });
                } else {
                    throw new Error(data.error || 'Error al eliminar cliente');
                }
            })
            .catch(error => {
                Swal.fire(
                    'Error',
                    error.message,
                    'error'
                );
            });
        }
    });
}

// Función para marcar factura como pagada
function marcarPagada(facturaId) {
    Swal.fire({
        title: '¿Marcar como pagada?',
        text: "¿Deseas marcar esta factura como pagada?",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#28a745',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Sí, marcar como pagada',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/facturas/${facturaId}/pagar`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire(
                        '¡Actualizada!',
                        'La factura ha sido marcada como pagada.',
                        'success'
                    ).then(() => {
                        location.reload();
                    });
                } else {
                    throw new Error(data.error || 'Error al actualizar factura');
                }
            })
            .catch(error => {
                Swal.fire(
                    'Error',
                    error.message,
                    'error'
                );
            });
        }
    });
}

// Función para agregar nota
function agregarNota() {
    Swal.fire({
        title: 'Nueva Nota',
        input: 'textarea',
        inputLabel: 'Contenido de la nota',
        inputPlaceholder: 'Escribe aquí la nota...',
        showCancelButton: true,
        confirmButtonText: 'Guardar',
        cancelButtonText: 'Cancelar',
        inputValidator: (value) => {
            if (!value) {
                return 'Debes escribir algo';
            }
        }
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/clientes/<%= cliente.id %>/notas`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ nota: result.value })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire(
                        '¡Guardada!',
                        'La nota ha sido agregada.',
                        'success'
                    ).then(() => {
                        location.reload();
                    });
                } else {
                    throw new Error(data.error || 'Error al guardar nota');
                }
            })
            .catch(error => {
                Swal.fire(
                    'Error',
                    error.message,
                    'error'
                );
            });
        }
    });
}

// Función para eliminar nota
function eliminarNota(notaId) {
    Swal.fire({
        title: '¿Eliminar nota?',
        text: "Esta acción no se puede deshacer",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/clientes/<%= cliente.id %>/notas/${notaId}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire(
                        '¡Eliminada!',
                        'La nota ha sido eliminada.',
                        'success'
                    ).then(() => {
                        location.reload();
                    });
                } else {
                    throw new Error(data.error || 'Error al eliminar nota');
                }
            })
            .catch(error => {
                Swal.fire(
                    'Error',
                    error.message,
                    'error'
                );
            });
        }
    });
}

document.addEventListener('DOMContentLoaded', function() {
    // Manejar cambio de año
    const selectorAño = document.getElementById('selectorAño');
    if (selectorAño) {
        selectorAño.addEventListener('change', function() {
            const año = this.value;
            const url = new URL(window.location.href);
            url.searchParams.set('año', año);
            window.location.href = url.toString();
        });
    }
});

// Cargar planes en el select
async function cargarPlanes() {
    try {
        const response = await fetch('/planes/list');
        const planes = await response.json();
        
        const planSelect = document.getElementById('editPlan');
        planSelect.innerHTML = '<option value="">Sin plan</option>';
        
        planes.filter(plan => plan.activo).forEach(plan => {
            const option = document.createElement('option');
            option.value = plan.id;
            option.textContent = `${plan.nombre} - ↓${plan.velocidad_descarga}Mbps ↑${plan.velocidad_subida}Mbps - $${plan.precio}`;
            if (plan.id === <%= cliente.plan_id || 'null' %>) {
                option.selected = true;
            }
            planSelect.appendChild(option);
        });
    } catch (error) {
        console.error('Error al cargar planes:', error);
    }
}

// Manejar clic en botón de editar
document.querySelector('.editar-cliente').addEventListener('click', async function() {
    await cargarPlanes();
    const modal = new bootstrap.Modal(document.getElementById('editarClienteModal'));
    modal.show();
});

// Formatear DNI automáticamente
document.getElementById('editDni').addEventListener('input', function(e) {
    let value = e.target.value.replace(/[^0-9]/g, '');
    
    // Limitar a 13 dígitos
    if (value.length > 13) {
        value = value.slice(0, 13);
    }
    
    e.target.value = value;
});

// Manejar guardado de cambios
document.getElementById('guardarCambios').addEventListener('click', async function() {
    const formData = {
        nombre: document.getElementById('editNombre').value,
        apellido: document.getElementById('editApellido').value,
        dni: document.getElementById('editDni').value,
        email: document.getElementById('editEmail').value,
        telefono: document.getElementById('editTelefono').value,
        direccion: document.getElementById('editDireccion').value,
        plan_id: document.getElementById('editPlan').value || null
    };

    try {
        const response = await fetch(`/clientes/<%= cliente.id %>`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= csrfToken %>'
            },
            body: JSON.stringify(formData)
        });

        const result = await response.json();

        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: 'Cliente actualizado correctamente',
                showConfirmButton: false,
                timer: 1500
            }).then(() => {
                location.reload();
            });
        } else {
            throw new Error(result.error || 'Error al actualizar cliente');
        }
    } catch (error) {
        console.error('Error:', error);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: error.message || 'No se pudo actualizar el cliente'
        });
    }
});

// Manejar registro de pago
document.querySelectorAll('.registrar-pago').forEach(button => {
	    button.addEventListener('click', async function() {
	        const facturaId = this.dataset.facturaId;
            const saldoFactura = Number(this.dataset.saldo || 0);
	        
	        const { value: formValues } = await Swal.fire({
	            title: 'Registrar Pago',
	            html: `
                    <div class="alert alert-light border text-start py-2">
                        <div><strong>Saldo pendiente:</strong> L ${saldoFactura.toFixed(2)}</div>
                        <small class="text-muted">Si recibe más del saldo, el excedente queda como abono del cliente.</small>
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label">Monto recibido</label>
                        <input id="montoRecibido" type="number" min="0.01" step="0.01" class="form-control" value="${saldoFactura.toFixed(2)}">
                    </div>
	                <div class="mb-3">
	                    <label class="form-label">Método de Pago</label>
	                    <select id="metodoPago" class="form-select">
                        <option value="efectivo">Efectivo</option>
                        <option value="transferencia">Transferencia</option>
                        <option value="tarjeta">Tarjeta</option>
                    </select>
                </div>
            `,
            focusConfirm: false,
            showCancelButton: true,
	            confirmButtonText: 'Registrar',
	            cancelButtonText: 'Cancelar',
	            preConfirm: () => {
                    const montoRecibido = parseFloat(document.getElementById('montoRecibido').value);

                    if (!Number.isFinite(montoRecibido) || montoRecibido <= 0) {
                        Swal.showValidationMessage('Ingrese un monto recibido mayor a cero');
                        return false;
                    }

	                return {
	                    metodo_pago: document.getElementById('metodoPago').value,
                        monto_recibido: montoRecibido
	                }
	            }
        });

        if (formValues) {
            try {
                const response = await fetch(`/facturacion/${facturaId}/pago`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': '<%= csrfToken %>'
                    },
                    body: JSON.stringify(formValues)
                });

                const result = await response.json();

	                if (result.success) {
                        const abono = Number(result.data?.abono_generado || 0);
	                    Swal.fire({
	                        icon: 'success',
	                        title: 'Éxito',
	                        text: abono > 0
                                ? `Pago registrado. Abono a favor: L ${abono.toFixed(2)}`
                                : 'Pago registrado correctamente',
	                        showConfirmButton: false,
	                        timer: 2200
	                    }).then(() => {
                        location.reload();
                    });
                } else {
                    throw new Error(result.error || 'Error al registrar el pago');
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message || 'No se pudo registrar el pago'
                });
            }
        }
    });
});
</script> 
