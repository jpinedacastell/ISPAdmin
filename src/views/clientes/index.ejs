<%- include('../partials/header') %>

<style>
    /* Estilos para una tabla de clientes aún más compacta */
    #clientesTable {
        font-size: 0.9rem; /* Reduce el tamaño de la fuente de toda la tabla */
    }

    #clientesTable td,
    #clientesTable th {
        padding-top: 0.4rem;    /* Espaciado superior reducido */
        padding-bottom: 0.4rem; /* Espaciado inferior reducido */
        vertical-align: middle; /* Centra el contenido verticalmente */
    }

    /* Ajuste para el texto secundario (velocidades del plan) */
    #clientesTable .text-muted {
        font-size: 0.8em;
        line-height: 1.2;
    }
    
    /* Reduce el tamaño de los botones de acción */
    #clientesTable .btn-sm {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
    }
</style>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestión de Clientes</h1>
        <button type="button" class="btn btn-primary" id="btnNuevoCliente">
            <i class="fas fa-plus"></i> Nuevo Cliente
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            <!-- Filtros -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="filtroEstado" class="form-label">Estado del Cliente</label>
                    <select id="filtroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="activo">Activos</option>
                        <option value="inactivo">Inactivos</option>
                        <option value="sin_plan">Sin Plan</option>
                    </select>
                </div>
            </div>
            
            <div class="table-responsive">
                <table id="clientesTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>DNI</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Plan</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Los datos se cargarán dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Nuevo Cliente -->
<div class="modal fade" id="nuevoClienteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="nuevoClienteForm" novalidate>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="nuevoNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="nuevoNombre" required>
                        </div>
                        <div class="col-md-6">
                            <label for="nuevoApellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="nuevoApellido" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="nuevoDni" class="form-label">DNI <small class="text-muted">(opcional)</small></label>
                            <input type="text" class="form-control" id="nuevoDni"
                                   pattern="\d{13}"
                                   maxlength="13"
                                   title="DNI debe tener 13 dígitos numéricos">
                            <div class="form-text">13 dígitos numéricos</div>
                        </div>
                        <div class="col-md-6">
                            <label for="nuevoEmail" class="form-label">Email <small class="text-muted">(opcional)</small></label>
                            <input type="email" class="form-control" id="nuevoEmail">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="nuevoTelefono" class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" id="nuevoTelefono">
                        </div>
                        <div class="col-md-6">
                            <label for="nuevoPlan" class="form-label">Plan</label>
                            <select class="form-select" id="nuevoPlan" required>
                                <option value="">Seleccione un plan</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="nuevoDireccion" class="form-label">Dirección</label>
                        <textarea class="form-control" id="nuevoDireccion" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarNuevoCliente">
                    <i class="fas fa-save"></i> Guardar Cliente
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Edición -->
<div class="modal fade" id="editarClienteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editarClienteForm">
                    <input type="hidden" id="clienteId">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="editNombre" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editApellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="editApellido" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editDni" class="form-label">DNI <small class="text-muted">(opcional)</small></label>
                            <input type="text" class="form-control" id="editDni"
                                   pattern="\d{13}"
                                   maxlength="13"
                                   title="DNI debe tener 13 dígitos numéricos">
                            <div class="form-text">Formato: 13 dígitos numéricos (ejemplo: 1601199800012)</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="editEmail">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editTelefono" class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" id="editTelefono">
                        </div>
                        <div class="col-md-6">
                            <label for="editPlan" class="form-label">Plan</label>
                            <select class="form-select" id="editPlan">
                                <option value="">Sin plan</option>
                                <!-- Los planes se cargarán dinámicamente -->
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editDireccion" class="form-label">Dirección</label>
                        <textarea class="form-control" id="editDireccion" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarCambios">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/clientes/clientesUI.js"></script>
<script>
$(document).ready(function() {
    // Inicializar DataTable
    const table = $('#clientesTable').DataTable({
        ajax: {
            url: '/clientes/list',
            dataSrc: ''
        },
        columns: [
            { 
                data: 'dni',
                render: function(data) {
                    return data ? data.toUpperCase() : '';
                }
            },
            { 
                data: null,
                render: function(data) {
                    return `<a href="/clientes/${data.id}" class="text-decoration-none">
                                ${data.nombre} ${data.apellido}
                            </a>`;
                }
            },
            { data: 'email' },
            { data: 'telefono' },
            { 
                data: null,
                render: function(data) {
                    if (data.plan_nombre) {
                        return `${data.plan_nombre}<br>
                                <small class="text-muted">
                                    ↓${data.velocidad_descarga}Mbps ↑${data.velocidad_subida}Mbps
                                </small>`;
                    }
                    return '<span class="text-muted">Sin plan</span>';
                }
            },
            {
                data: null,
                render: (data) => ClientesUI.badgeEstado(data)
            },
            {
                data: null,
                orderable: false,
                render: function(data) {
                    const tienePlan = ClientesUI.claveEstado(data) !== 'sin_plan';
                    const toggleBtn = tienePlan ?
                                    `<button class="btn btn-sm btn-${data.activo ? 'danger' : 'success'} toggle-cliente me-1"
                                             data-cliente-id="${data.id}" title="${data.activo ? 'Desactivar' : 'Activar'}">
                                        <i class="fas fa-${data.activo ? 'ban' : 'check'}"></i>
                                    </button>` : '';

                    return `
                            ${toggleBtn}
                            <button class="btn btn-sm btn-primary editar-cliente me-1"
                                    data-cliente-id="${data.id}" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger eliminar-cliente"
                                    data-cliente-id="${data.id}"
                                    data-cliente-nombre="${data.nombre} ${data.apellido}" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                    `;
                }
            }
        ],
        order: [[1, 'asc']],
        language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
        },
        responsive: true,
        pageLength: 10,
        dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
             '<"row"<"col-sm-12"tr>>' +
             '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
    });

    // Filtro personalizado para DataTables
    $.fn.dataTable.ext.search = [];
    
    // Función de filtrado
    function filtrarPorEstado(settings, data, dataIndex) {
        const row = table.row(dataIndex).data();
        return !row || ClientesUI.cumpleFiltro($('#filtroEstado').val(), row);
    }

    // Agregar la función de filtrado a DataTables
    $.fn.dataTable.ext.search.push(filtrarPorEstado);

    // Evento change del select de filtro
    $('#filtroEstado').on('change', function() {
        table.draw(); // Redibujar la tabla aplicando el filtro
    });

    // Formatear DNI automáticamente
    document.querySelectorAll('input[id$="Dni"]').forEach(input => {
        input.addEventListener('input', function(e) {
            let value = e.target.value.replace(/[^0-9]/g, '');
            
            // Limitar a 13 dígitos
            if (value.length > 13) {
                value = value.slice(0, 13);
            }
            
            e.target.value = value;
        });
    });

    // Cargar planes en el select
    async function cargarPlanes(selectId = 'editPlan', textoVacio = 'Sin plan') {
        try {
            const response = await fetch('/planes/list');
            const planes = await response.json();

            const planSelect = document.getElementById(selectId);
            planSelect.innerHTML = `<option value="">${textoVacio}</option>`;
            
            planes.filter(plan => plan.activo).forEach(plan => {
                const option = document.createElement('option');
                option.value = plan.id;
                option.textContent = `${plan.nombre} - ↓${plan.velocidad_descarga}Mbps ↑${plan.velocidad_subida}Mbps - $${plan.precio}`;
                planSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error al cargar planes:', error);
        }
    }

    // Manejar clic en botón de editar
    $('#clientesTable').on('click', '.editar-cliente', async function() {
        const clienteId = $(this).data('cliente-id');
        
        try {
            const response = await fetch(`/clientes/${clienteId}/edit`);
            const cliente = await response.json();

            // Llenar el formulario
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('editNombre').value = cliente.nombre;
            document.getElementById('editApellido').value = cliente.apellido;
            document.getElementById('editDni').value = cliente.dni || '';
            document.getElementById('editEmail').value = cliente.email;
            document.getElementById('editTelefono').value = cliente.telefono || '';
            document.getElementById('editDireccion').value = cliente.direccion || '';
            
            // Cargar planes y mostrar modal
            await cargarPlanes();
            document.getElementById('editPlan').value = cliente.plan_id || ''; // Seleccionar el plan después de cargarlos
            
            const modal = new bootstrap.Modal(document.getElementById('editarClienteModal'));
            modal.show();
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'No se pudo cargar los datos del cliente',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    });

    // Manejar clic en botón de toggle
    $('#clientesTable').on('click', '.toggle-cliente', async function() {
        const clienteId = $(this).data('cliente-id');
        
        try {
            const response = await fetch(`/clientes/${clienteId}/toggle`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>'
                }
            });
            
            if (!response.ok) {
                const result = await response.json();
                throw new Error(result.error || 'Error al cambiar el estado del cliente');
            }
            
            const result = await response.json();
            
            if (result.success) {
                table.ajax.reload(null, false);
                Swal.fire({
                    icon: 'success',
                    title: 'Éxito',
                    text: result.message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            } else {
                throw new Error(result.error || 'Error al cambiar el estado del cliente');
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'No se pudo cambiar el estado del cliente',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    });

    // Manejar clic en botón de eliminar
    $('#clientesTable').on('click', '.eliminar-cliente', function() {
        const { clienteId, clienteNombre } = $(this).data();
        ClientesUI.eliminarCliente(clienteId, clienteNombre, () => table.ajax.reload(null, false));
    });

    // Nuevo cliente
    const CAMPOS_NUEVO_CLIENTE = {
        nombre: 'nuevoNombre',
        apellido: 'nuevoApellido',
        dni: 'nuevoDni',
        email: 'nuevoEmail',
        telefono: 'nuevoTelefono',
        direccion: 'nuevoDireccion',
        plan_id: 'nuevoPlan'
    };
    const modalNuevoCliente = new bootstrap.Modal(document.getElementById('nuevoClienteModal'));

    $('#btnNuevoCliente').on('click', async function() {
        document.getElementById('nuevoClienteForm').reset();
        await cargarPlanes('nuevoPlan', 'Seleccione un plan');
        modalNuevoCliente.show();
    });

    $('#guardarNuevoCliente').on('click', async function() {
        const form = document.getElementById('nuevoClienteForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const datos = Object.fromEntries(
            Object.entries(CAMPOS_NUEVO_CLIENTE).map(([campo, id]) => [campo, document.getElementById(id).value.trim()])
        );

        try {
            const response = await fetch('/clientes', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify(datos)
            });
            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.error || 'Error al crear el cliente');
            }

            modalNuevoCliente.hide();
            table.ajax.reload(null, false);
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: 'Cliente creado correctamente',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: ClientesUI.DURACION_TOAST_MS
            });
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'No se pudo crear el cliente'
            });
        }
    });

    // Manejar guardado de cambios
    document.getElementById('guardarCambios').addEventListener('click', async function() {
        const clienteId = document.getElementById('clienteId').value;
        const formData = {
            nombre: document.getElementById('editNombre').value,
            apellido: document.getElementById('editApellido').value,
            dni: document.getElementById('editDni').value,
            email: document.getElementById('editEmail').value,
            telefono: document.getElementById('editTelefono').value,
            direccion: document.getElementById('editDireccion').value,
            plan_id: document.getElementById('editPlan').value || null
        };

        try {
            const response = await fetch(`/clientes/${clienteId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Éxito',
                    text: 'Cliente actualizado correctamente',
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    $('#editarClienteModal').modal('hide');
                    table.ajax.reload();
                });
            } else {
                throw new Error(result.error || 'Error al actualizar cliente');
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'No se pudo actualizar el cliente'
            });
        }
    });
});
</script>

<%- include('../partials/footer') %>

