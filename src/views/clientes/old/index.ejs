<%- include('../partials/header') %>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestión de Clientes</h1>
        <a href="/clientes/nuevo" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Cliente
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <!-- Filtros -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="filtroEstado" class="form-label">Estado del Cliente</label>
                    <select id="filtroEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="activo">Activos</option>
                        <option value="inactivo">Inactivos</option>
                        <option value="sin_plan">Sin Plan</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table id="clientesTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>DNI</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Plan</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Los datos se cargarán dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Edición -->
<div class="modal fade" id="editarClienteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editarClienteForm">
                    <input type="hidden" id="clienteId">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="editNombre" required>
                        </div>
                        <div class="col-md-6">
                            <label for="editApellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="editApellido" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editDni" class="form-label">DNI</label>
                            <input type="text" class="form-control" id="editDni" required
                                   pattern="\d{13}"
                                   maxlength="13"
                                   title="DNI debe tener 13 dígitos numéricos">
                            <div class="form-text">Formato: 13 dígitos numéricos (ejemplo: 1601199800012)</div>
                        </div>
                        <div class="col-md-6">
                            <label for="editEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="editEmail" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editTelefono" class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" id="editTelefono">
                        </div>
                        <div class="col-md-6">
                            <label for="editPlan" class="form-label">Plan</label>
                            <select class="form-select" id="editPlan">
                                <option value="">Sin plan</option>
                                <!-- Los planes se cargarán dinámicamente -->
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editDireccion" class="form-label">Dirección</label>
                        <textarea class="form-control" id="editDireccion" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarCambios">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Obtener el token CSRF del meta tag y configurar headers por defecto
const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
const defaultHeaders = {
    'Content-Type': 'application/json',
    'CSRF-Token': csrfToken
};

$(document).ready(function() {
    // Inicializar DataTable
    const table = $('#clientesTable').DataTable({
        ajax: {
            url: '/clientes/list',
            dataSrc: ''
        },
        columns: [
            { 
                data: 'dni',
                render: function(data) {
                    return data ? data.toUpperCase() : '';
                }
            },
            { 
                data: null,
                render: function(data) {
                    return `<a href="/clientes/${data.id}" class="text-decoration-none">
                        ${data.nombre} ${data.apellido}
                    </a>`;
                }
            },
            { data: 'email' },
            { data: 'telefono' },
            { 
                data: null,
                render: function(data) {
                    if (data.plan_nombre) {
                        return `${data.plan_nombre}<br>
                               <small class="text-muted">
                                   ↓${data.velocidad_descarga}Mbps ↑${data.velocidad_subida}Mbps
                               </small>`;
                    }
                    return '<span class="text-muted">Sin plan</span>';
                }
            },
            {
                data: null,
                render: function(data) {
                    const estado = data.activo;
                    if (estado === undefined || estado === null) {
                        return '<span class="badge bg-secondary">Sin plan</span>';
                    }
                    return estado ? 
                        '<span class="badge bg-success">Activo</span>' : 
                        '<span class="badge bg-danger">Inactivo</span>';
                }
            },
            {
                data: null,
                orderable: false,
                render: function(data) {
                    const toggleBtn = data.activo !== undefined ?
                        `<button class="btn btn-sm btn-${data.activo ? 'danger' : 'success'} toggle-cliente me-1" 
                                 data-cliente-id="${data.id}" title="${data.activo ? 'Desactivar' : 'Activar'}">
                            <i class="fas fa-${data.activo ? 'ban' : 'check'}"></i>
                        </button>` : '';

                    return `
                        ${toggleBtn}
                        <button class="btn btn-sm btn-primary editar-cliente" 
                                data-cliente-id="${data.id}" title="Editar">
                            <i class="fas fa-edit"></i>
                        </button>
                    `;
                }
            }
        ],
        order: [[1, 'asc']],
        language: {
            url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
        },
        responsive: true,
        pageLength: 10,
        dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
             '<"row"<"col-sm-12"tr>>' +
             '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
    });

    // Filtro personalizado para DataTables
    $.fn.dataTable.ext.search = [];
    
    // Función de filtrado
    function filtrarPorEstado(settings, data, dataIndex) {
        const valorFiltro = $('#filtroEstado').val();
        if (!valorFiltro) return true; // Si no hay filtro, mostrar todos
        
        const row = table.row(dataIndex).data();
        if (!row) return true;

        switch (valorFiltro) {
            case 'activo':
                return row.activo === true;
            case 'inactivo':
                return row.activo === false;
            case 'sin_plan':
                return row.activo === null || row.activo === undefined;
            default:
                return true;
        }
    }

    // Agregar la función de filtrado a DataTables
    $.fn.dataTable.ext.search.push(filtrarPorEstado);

    // Evento change del select de filtro
    $('#filtroEstado').on('change', function() {
        table.draw(); // Redibujar la tabla aplicando el filtro
    });

    // Formatear DNI automáticamente
    document.querySelectorAll('input[id$="Dni"]').forEach(input => {
        input.addEventListener('input', function(e) {
            let value = e.target.value.replace(/[^0-9]/g, '');
            
            // Limitar a 13 dígitos
            if (value.length > 13) {
                value = value.slice(0, 13);
            }
            
            e.target.value = value;
        });
    });

    // Cargar planes en el select
    async function cargarPlanes() {
        try {
            const response = await fetch('/planes/list', {
                headers: defaultHeaders
            });
            const planes = await response.json();
            
            const planSelect = document.getElementById('editPlan');
            planSelect.innerHTML = '<option value="">Sin plan</option>';
            
            planes.filter(plan => plan.activo).forEach(plan => {
                const option = document.createElement('option');
                option.value = plan.id;
                option.textContent = `${plan.nombre} - ↓${plan.velocidad_descarga}Mbps ↑${plan.velocidad_subida}Mbps - $${plan.precio}`;
                planSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error al cargar planes:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'No se pudieron cargar los planes',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    }

    // Manejar clic en botón de editar
    $('#clientesTable').on('click', '.editar-cliente', async function() {
        const clienteId = $(this).data('cliente-id');
        
        try {
            const response = await fetch(`/clientes/${clienteId}/edit`, {
                headers: defaultHeaders
            });
            
            if (!response.ok) {
                throw new Error('Error al obtener los datos del cliente');
            }

            const cliente = await response.json();

            // Llenar el formulario
            document.getElementById('clienteId').value = cliente.id;
            document.getElementById('editNombre').value = cliente.nombre;
            document.getElementById('editApellido').value = cliente.apellido;
            document.getElementById('editDni').value = cliente.dni || '';
            document.getElementById('editEmail').value = cliente.email;
            document.getElementById('editTelefono').value = cliente.telefono || '';
            document.getElementById('editDireccion').value = cliente.direccion || '';

            // Cargar planes y mostrar modal
            await cargarPlanes();
            document.getElementById('editPlan').value = cliente.plan_id || '';

            const modal = new bootstrap.Modal(document.getElementById('editarClienteModal'));
            modal.show();
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'No se pudo cargar los datos del cliente',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    });

    // Manejar clic en botón de toggle
    $('#clientesTable').on('click', '.toggle-cliente', async function() {
        const clienteId = $(this).data('cliente-id');
        
        try {
            const response = await fetch(`/clientes/${clienteId}/toggle`, {
                method: 'PATCH',
                headers: defaultHeaders
            });
            
            if (!response.ok) {
                const result = await response.json();
                throw new Error(result.error || 'Error al cambiar el estado del cliente');
            }
            
            const result = await response.json();
            
            if (result.success) {
                // Recargar la tabla
                table.ajax.reload(null, false);
                
                // Mostrar notificación
                Swal.fire({
                    icon: 'success',
                    title: 'Éxito',
                    text: result.message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            } else {
                throw new Error(result.error || 'Error al cambiar el estado del cliente');
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'No se pudo cambiar el estado del cliente',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    });

    // Manejar guardado de cambios
    document.getElementById('guardarCambios').addEventListener('click', async function() {
        const clienteId = document.getElementById('clienteId').value;
        const formData = {
            nombre: document.getElementById('editNombre').value,
            apellido: document.getElementById('editApellido').value,
            dni: document.getElementById('editDni').value,
            email: document.getElementById('editEmail').value,
            telefono: document.getElementById('editTelefono').value,
            direccion: document.getElementById('editDireccion').value,
            plan_id: document.getElementById('editPlan').value || null
        };

        try {
            const response = await fetch(`/clientes/${clienteId}`, {
                method: 'PUT',
                headers: defaultHeaders,
                body: JSON.stringify(formData)
            });

            if (!response.ok) {
                throw new Error('Error al actualizar el cliente');
            }

            const result = await response.json();

            if (result.success) {
                // Cerrar el modal
                bootstrap.Modal.getInstance(document.getElementById('editarClienteModal')).hide();
                
                // Recargar la tabla
                table.ajax.reload();

                // Mostrar notificación
                Swal.fire({
                    icon: 'success',
                    title: 'Éxito',
                    text: 'Cliente actualizado correctamente',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });
            } else {
                throw new Error(result.error);
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'No se pudo actualizar el cliente',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000
            });
        }
    });
});
</script>

<%- include('../partials/footer') %>

<!-- DataTables -->
